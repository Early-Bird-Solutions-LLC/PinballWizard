{
  // Runs the .NET Aspire AppHost locally (Cosmos preview emulator + Azurite).
  // Mirrors start-apphost.ps1. Terminal > Run Task… > "Run AppHost (Aspire)".
  "version": "2.0.0",
  "tasks": [
    {
      // preLaunchTask for the launch.json coreclr configs — ensures the dll
      // each config points at is freshly built before the debugger attaches.
      "label": "build",
      "detail": "dotnet build the solution (preLaunchTask for the F5 debug configs).",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/PinballWizard.slnx"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Run AppHost (Aspire)",
      "detail": "Launch the .NET Aspire AppHost locally (Cosmos emulator + Azurite).",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/start-apphost.ps1"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": "build"
    },
    {
      "label": "Run AppHost (dotnet run)",
      "detail": "Same as above but invokes dotnet run directly on the AppHost csproj.",
      "type": "shell",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/PinballWizard.AppHost"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}

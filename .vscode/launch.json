{
  // Debug configurations (Run and Debug view, F5).
  //
  // These use the "coreclr" launch type (not the C# Dev Kit "dotnet" type)
  // specifically because the "dotnet" type does NOT reliably honour an explicit
  // env block or a launchSettings.json profile — environmentVariables are
  // silently dropped (microsoft/vscode-dotnettools#608, #241). "coreclr" honours
  // the "env" block below, which is load-bearing here:
  //
  //   DOTNET_ENVIRONMENT=Development makes the .NET Generic Host load
  //   user-secrets. The AppHost's Cosmos preview emulator passphrase lives in
  //   user-secrets (Parameters:cosmos-certificate-passphrase); without
  //   Development, Aspire can't resolve it and prompts for a password on every
  //   launch. Running via "dotnet run" (the tasks.json tasks / start-apphost.ps1)
  //   gets Development from the launchSettings "https" profile automatically —
  //   these configs replicate that so F5 behaves the same.
  //
  // Cost of "coreclr": an explicit dll path with the target framework (net10.0,
  // centrally pinned in Directory.Build.props). The shared "build" preLaunchTask
  // (tasks.json) ensures the dll is fresh before launch.
  //
  // The canonical local entry point is the Aspire AppHost — it orchestrates the
  // Cosmos preview emulator + Azurite and the API/Web resources. The standalone
  // API / Web / CLI configs debug a single process in isolation.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AppHost (Aspire)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/PinballWizard.AppHost/bin/Debug/net10.0/PinballWizard.AppHost.dll",
      "cwd": "${workspaceFolder}/src/PinballWizard.AppHost",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "CLI (scraper / sync / eval)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/PinballWizard.Cli/bin/Debug/net10.0/PinballWizard.Cli.dll",
      "cwd": "${workspaceFolder}/src/PinballWizard.Cli",
      // Add the command you're debugging, e.g. ["--help"] or ["--source", "opdb"].
      "args": [],
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "API (standalone)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/PinballWizard.Api/bin/Debug/net10.0/PinballWizard.Api.dll",
      "cwd": "${workspaceFolder}/src/PinballWizard.Api",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Web (standalone)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/PinballWizard.Web/bin/Debug/net10.0/PinballWizard.Web.dll",
      "cwd": "${workspaceFolder}/src/PinballWizard.Web",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal"
    }
  ]
}

{
  // Debug configurations (Run and Debug view, F5).
  //
  // AppHost uses the "aspire" launch type (Aspire VS Code extension
  // microsoft-aspire.aspire-vscode + the Aspire CLI on PATH). It runs the
  // AppHost under `aspire run`, which applies the launchSettings "https"
  // profile — Development (so user-secrets load, including the Cosmos emulator
  // passphrase), the stable dashboard token, and auto-launching the dashboard
  // in a browser. This replaces an earlier coreclr config that had to
  // hand-replicate each of those (env + token + browser) and still couldn't
  // open the dashboard. Prereqs: the Aspire extension + `aspire` CLI
  // (~/.dotnet/tools, on PATH) — `dotnet tool install -g Aspire.Cli`.
  //
  // CLI / API / Web use the "coreclr" type for debugging a single process in
  // isolation (no orchestrator). The "dotnet" (C# Dev Kit) type silently drops
  // env vars (microsoft/vscode-dotnettools#608, #241), so coreclr + an explicit
  // "env" block is used to force Development (loads each project's user-secrets
  // / Development config). Cost: an explicit net10.0 dll path (TFM is centrally
  // pinned in Directory.Build.props); the shared "build" preLaunchTask
  // (tasks.json) keeps the dll fresh.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AppHost (Aspire)",
      "type": "aspire",
      "request": "launch",
      "program": "${workspaceFolder}/src/PinballWizard.AppHost/PinballWizard.AppHost.csproj",
      // Belt-and-suspenders for the passphrase: `aspire run` already applies the
      // launchSettings https profile (Development), but set it explicitly so a
      // future launchSettings change can't silently drop user-secrets loading.
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "CLI (scraper / sync / eval)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/PinballWizard.Cli/bin/Debug/net10.0/PinballWizard.Cli.dll",
      "cwd": "${workspaceFolder}/src/PinballWizard.Cli",
      // Add the command you're debugging, e.g. ["--help"] or ["--source", "opdb"].
      "args": [],
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "API (standalone)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/PinballWizard.Api/bin/Debug/net10.0/PinballWizard.Api.dll",
      "cwd": "${workspaceFolder}/src/PinballWizard.Api",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Web (standalone)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/PinballWizard.Web/bin/Debug/net10.0/PinballWizard.Web.dll",
      "cwd": "${workspaceFolder}/src/PinballWizard.Web",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal"
    }
  ]
}

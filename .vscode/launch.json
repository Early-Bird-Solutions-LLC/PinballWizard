{
  // Debug configurations (Run and Debug view, F5).
  //
  // These use the C# Dev Kit "dotnet" launch type, which resolves the build
  // output from the .csproj directly — no hardcoded bin/<config>/<tfm> dll
  // paths to drift as the target framework moves. Requires the C# Dev Kit
  // extension (ms-dotnettools.csdevkit); install it if F5 reports an unknown
  // debug type.
  //
  // The canonical local entry point is the Aspire AppHost — it orchestrates
  // the Cosmos preview emulator + Azurite and the API/Web/Worker resources
  // (mirrors start-apphost.ps1 / the "Run AppHost" tasks in tasks.json). The
  // standalone API / Web / CLI configs are for debugging a single process in
  // isolation, without the orchestrator.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AppHost (Aspire)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/PinballWizard.AppHost/PinballWizard.AppHost.csproj"
    },
    {
      "name": "CLI (scraper / sync / eval)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/PinballWizard.Cli/PinballWizard.Cli.csproj",
      // Add the command you're debugging, e.g. ["--help"] or
      // ["--source", "opdb"]. Left empty so it prompts for usage on launch.
      "args": []
    },
    {
      "name": "API (standalone)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/PinballWizard.Api/PinballWizard.Api.csproj"
    },
    {
      "name": "Web (standalone)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/PinballWizard.Web/PinballWizard.Web.csproj"
    }
  ]
}

<Project>
  <!--
    Centralized package management (CPM) for the PinballWizard solution.
    Every package version pinned in this file; csproj PackageReference
    entries carry only Include="..." with no Version. Single source of
    truth simplifies upgrade audits, reduces version drift across
    projects, and makes Renovate / Dependabot bumps land cleanly as
    one-line edits here rather than fanning out across N csprojs.

    See https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management
    for the full feature set. Locked-mode restore in Directory.Build.props
    composes cleanly with CPM — packages.lock.json files still capture
    the exact restored graph; CPM just centralizes the versions used to
    build that graph.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Global package reference: SourceLink applies to every project so
      symbols pages map back to GitHub URLs. Replaces the per-project
      PackageReference pattern previously held in Directory.Build.props
      (the GlobalPackageReference + CPM combo is the modern equivalent).
    -->
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
  </ItemGroup>
  <ItemGroup Label="Aspire — local-dev orchestrator + Cosmos / Storage emulator hosts">
    <PackageVersion Include="Aspire.Hosting.Azure.CosmosDB" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.5.3" />
    <PackageVersion Include="Aspire.Microsoft.Azure.Cosmos" Version="13.5.3" />
    <PackageVersion Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup Label="Azure data-plane SDKs — Foundry / OpenAI / Cosmos / AI Search / Identity / ARM">
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageVersion Include="Azure.AI.Projects" Version="2.0.1" />
    <PackageVersion Include="Azure.Core" Version="1.62.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.4" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.4" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <!-- Azure.Monitor.Query 1.7.1 — Log Analytics query client for live telemetry reads.
         Resolved via `dotnet add package Azure.Monitor.Query` 2026-07-01 (latest stable).
         Used by the AdminMonitoring feature (#606) to query Log Analytics workspaces
         with DefaultAzureCredential — no API key in code or config. -->
    <PackageVersion Include="Azure.Monitor.Query" Version="1.7.1" />
    <!-- Azure.ResourceManager.AppContainers 1.5.0 — ARM control-plane SDK for
         Microsoft.App/jobs (list, read executions, trigger). GA stable.
         Source: https://www.nuget.org/packages/Azure.ResourceManager.AppContainers -->
    <PackageVersion Include="Azure.ResourceManager.AppContainers" Version="1.5.0" />
    <PackageVersion Include="Azure.ResourceManager.CosmosDB" Version="1.5.0" />
    <PackageVersion Include="Azure.Search.Documents" Version="12.0.0" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
  </ItemGroup>
  <ItemGroup Label="Microsoft Agent Framework — Foundry-bound IAiRouter primitives (ADR-0014)">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.5.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Foundry" Version="1.5.0" />
  </ItemGroup>
  <ItemGroup Label="Microsoft.Extensions.* — Hosting / DI / Configuration / Logging / Options">
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <!-- Microsoft.Extensions.Logging — concrete LoggerFactory.Create used by the
         PerfMetrics console tool. Abstractions alone don't ship LoggerFactory. Verified via
         `dotnet package search Microsoft.Extensions.Logging` on 2026-07-09. -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
  </ItemGroup>
  <ItemGroup Label="Phase 4 RAG pipeline — chunking + PDF extraction">
    <!--
      Microsoft.ML.Tokenizers + Cl100kBase data package power the Phase 4
      hybrid chunker (ADR-0019) and the metadata-card synthesizer (W3-1).
      cl100k_base is the BPE tokenizer used by `text-embedding-3-large`
      (ADR-0020).
    -->
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <!--
      Microsoft.ML.Tokenizers 2.0.0 transitively pulls Microsoft.Bcl.Memory
      9.0.4, which has a high-severity vuln (GHSA-73j8-2gch-69rq).
      Direct-pin to a current 10.x here so consuming projects (Application) can add
      a no-Version PackageReference and pick up the override without a
      transitive-resolution NU1903 build break. Remove once
      Microsoft.ML.Tokenizers ships a release that depends on Bcl.Memory
      >= 10.x.
    -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.11" />
    <!--
      PdfPig (namespace UglyToad.PdfPig) is the pure-managed PDF reader
      used by Phase 4 W1-5's PdfPigDocumentTextExtractor. Reads text +
      outline from PDF streams; no native dependencies; compatible with
      the showcase posture (no GPL/AGPL like iText 7 community license).
    -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <ItemGroup Label="OpenTelemetry — exporters + auto-instrumentation (ServiceDefaults)">
    <!-- Azure.Monitor.OpenTelemetry.Exporter — Entra-authenticated log exporter for the
         PerfMetrics console tool (Phase 1 perf-trend tracking). Verified latest stable via
         `dotnet package search Azure.Monitor.OpenTelemetry.Exporter` on 2026-07-09. -->
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
  </ItemGroup>
  <ItemGroup Label="Scraping / parsing / browser automation">
    <PackageVersion Include="AngleSharp" Version="1.7.3" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <!-- Azure.Developer.Playwright 1.0.0 (GA stable) — connects to a remote Chromium
         instance on Azure Playwright Workspaces via BrowserType.ConnectAsync, instead
         of launching a local browser process. Introduced for #855: local Chromium was
         OOMKilling the 1 GiB stern-games/bulletins/refresh ACA jobs. See
         docs/superpowers/specs/2026-08-17-stern-playwright-workspaces-migration-design.md. -->
    <PackageVersion Include="Azure.Developer.Playwright" Version="1.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>
  <ItemGroup Label="Accessibility testing — axe-core via Playwright (Wave 3 PR-Q1b)">
    <!--
      Deque.AxeCore.Playwright wraps axe-core (the industry-standard WCAG
      scanner) for Playwright page objects. Used in
      tests/PinballWizard.Web.Tests/A11y/ to assert WCAG 2.1 AA compliance
      on every public route via a real Chromium browser.
    -->
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.13.0" />
  </ItemGroup>
  <ItemGroup Label="Tests — xUnit + NSubstitute + bUnit + test SDK">
    <PackageVersion Include="bunit" Version="2.9.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!--
      System.Security.Cryptography.Xml is still pulled transitively by bunit 2.x
      at a vulnerable version, so it stays direct-pinned here to a safe one.

      Keep this at the latest patch of the 10.0.x train. The 10.0.9 pin went
      vulnerable on 2026-07-21 when five high-severity advisories landed against
      <= 10.0.9 (CVE-2026-47302, -47304, -50525, -50527, -50648), which broke
      restore under TreatWarningsAsErrors and took the scheduled canary down.
      All five list 10.0.10 as the first patched version.
    -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <!--
      Microsoft.AspNetCore.TestHost enables in-process TestServer testing
      for WizardAskStreamEndpointTests (Wave 1 PR-F2). Version matches
      ASP.NET Core / .NET 10 GA train.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup Label="Web — Markdown rendering for the /engineering live-docs section">
    <!--
      Markdig 1.3.2 — CommonMark-compliant Markdown-to-HTML pipeline used
      by the /engineering section to render the repo's own docs in-browser.
      Version verified via: dotnet package search Markdig (take 1)
      Result on 2026-07-06: latest stable = 1.3.2, owner xoofx, 68 M+ downloads.
      See src/PinballWizard.Web/PinballWizard.Web.csproj for the consumer.
    -->
    <PackageVersion Include="Markdig" Version="1.3.2" />
  </ItemGroup>
  <ItemGroup Label="Web — Blazor frontend (ADR-0026) + Entra External ID auth (ADR-0009)">
    <!--
      MudBlazor 9.x targets .NET 8+ and supports .NET 10 via the .NET 8
      TFM forward-compat path. Pin to a specific minor so template / theme
      shape is reproducible. Bump majors as a dedicated, reviewed PR (the
      Renovate Dependency Dashboard holds them — ADR-0037).

      HELD at 9.5.0 — do not bump without an accompanying a11y fix. 9.7.0
      changes MudSelect's rendered markup: the input slot gains
      role="combobox" with no accessible name, which trips the axe rule
      aria-input-field-name (WCAG 2.1 AA) on /admin/document-triage and
      /admin/link-overrides. Caught by the Accessibility-category suite in
      the ui-tests CI job, which is excluded from the main test filter — so
      a green "Build, test, coverage" does NOT clear a MudBlazor bump.
      Moving to 9.7.0 means labelling those MudSelects first.
    -->
    <PackageVersion Include="MudBlazor" Version="9.5.0" />
    <!--
      Microsoft.Identity.Web supports Entra External ID tenants natively per
      ADR-0009. The app uses only AddMicrosoftIdentityWebApp + AddMicrosoftIdentityUI
      (basic OIDC sign-in) — none of the surface v4 removed (legacy downstream-API,
      TokenAcquirer credentials, sync client-credential shims). Majors land via the
      Renovate Dependency Dashboard as reviewed PRs (ADR-0037).
    -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageVersion Include="Microsoft.Identity.Web.UI" Version="4.14.2" />
    <!--
      Blazor auto-render mode (ADR-0026 § 1) requires the WASM runtime
      in the Client project and the WASM static-asset server in the
      Server project. Both match the ASP.NET Core / .NET 10 GA train.
      Microsoft.AspNetCore.Components.WebAssembly is NOT implicit in
      the BlazorWebAssembly SDK — it must be an explicit reference.
      Microsoft.AspNetCore.Components.WebAssembly.Server must be
      referenced by the Server (PinballWizard.Web) so Kestrel serves
      the WASM bootstrap and static framework files.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.11" />
  </ItemGroup>
</Project>
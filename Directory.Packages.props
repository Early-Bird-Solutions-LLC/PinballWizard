<Project>
  <!--
    Centralized package management (CPM) for the PinballWizard solution.
    Every package version pinned in this file; csproj PackageReference
    entries carry only Include="..." with no Version. Single source of
    truth simplifies upgrade audits, reduces version drift across
    projects, and makes Renovate / Dependabot bumps land cleanly as
    one-line edits here rather than fanning out across N csprojs.

    See https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management
    for the full feature set. Locked-mode restore in Directory.Build.props
    composes cleanly with CPM — packages.lock.json files still capture
    the exact restored graph; CPM just centralizes the versions used to
    build that graph.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Global package reference: SourceLink applies to every project so
      symbols pages map back to GitHub URLs. Replaces the per-project
      PackageReference pattern previously held in Directory.Build.props
      (the GlobalPackageReference + CPM combo is the modern equivalent).
    -->
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.203" />
  </ItemGroup>
  <ItemGroup Label="Security pins — direct references that lift a vulnerable transitive">
    <!--
      MessagePack rides in transitively via the Aspire hosting packages at
      2.5.192, which is vulnerable to GHSA-hv8m-jj95-wg3x (LZ4 decompression
      AccessViolation on bad input; patched in 2.5.301). NU1903 is
      warning-as-error here, so the advisory broke every restore the day it
      published. Direct-referencing the patched version from AppHost lifts
      the transitive. Remove this pin (and the AppHost PackageReference)
      when the Aspire packages ship a dependency >= 2.5.301.
    -->
    <PackageVersion Include="MessagePack" Version="2.5.301" />
  </ItemGroup>
  <ItemGroup Label="Aspire — local-dev orchestrator + Cosmos / Storage emulator hosts">
    <PackageVersion Include="Aspire.Hosting.Azure.CosmosDB" Version="13.4.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.4.4" />
    <PackageVersion Include="Aspire.Microsoft.Azure.Cosmos" Version="13.4.0" />
    <PackageVersion Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup Label="Azure data-plane SDKs — Foundry / OpenAI / Cosmos / AI Search / Identity / ARM">
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="Azure.AI.Projects" Version="2.0.1" />
    <PackageVersion Include="Azure.Core" Version="1.53.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.3" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.3" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.ResourceManager.CosmosDB" Version="1.4.0" />
    <PackageVersion Include="Azure.Search.Documents" Version="11.7.0" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.59.0" />
  </ItemGroup>
  <ItemGroup Label="Microsoft Agent Framework — Foundry-bound IAiRouter primitives (ADR-0014)">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.4.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Foundry" Version="1.4.0" />
  </ItemGroup>
  <ItemGroup Label="Microsoft.Extensions.* — Hosting / DI / Configuration / Logging / Options">
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.5.0" />
  </ItemGroup>
  <ItemGroup Label="Phase 4 RAG pipeline — chunking + PDF extraction">
    <!--
      Microsoft.ML.Tokenizers + Cl100kBase data package power the Phase 4
      hybrid chunker (ADR-0019) and the metadata-card synthesizer (W3-1).
      cl100k_base is the BPE tokenizer used by `text-embedding-3-large`
      (ADR-0020).
    -->
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <!--
      Microsoft.ML.Tokenizers 2.0.0 transitively pulls Microsoft.Bcl.Memory
      9.0.4, which has a high-severity vuln (GHSA-73j8-2gch-69rq).
      Direct-pin to 10.0.7 here so consuming projects (Application) can add
      a no-Version PackageReference and pick up the override without a
      transitive-resolution NU1903 build break. Remove once
      Microsoft.ML.Tokenizers ships a release that depends on Bcl.Memory
      >= 10.x.
    -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.7" />
    <!--
      PdfPig (namespace UglyToad.PdfPig) is the pure-managed PDF reader
      used by Phase 4 W1-5's PdfPigDocumentTextExtractor. Reads text +
      outline from PDF streams; no native dependencies; compatible with
      the showcase posture (no GPL/AGPL like iText 7 community license).
    -->
    <PackageVersion Include="PdfPig" Version="0.1.14" />
  </ItemGroup>
  <ItemGroup Label="OpenTelemetry — exporters + auto-instrumentation (ServiceDefaults)">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
  </ItemGroup>
  <ItemGroup Label="Scraping / parsing / browser automation">
    <PackageVersion Include="AngleSharp" Version="1.4.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.59.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="System.CommandLine" Version="2.0.7" />
  </ItemGroup>
  <ItemGroup Label="Accessibility testing — axe-core via Playwright (Wave 3 PR-Q1b)">
    <!--
      Deque.AxeCore.Playwright wraps axe-core (the industry-standard WCAG
      scanner) for Playwright page objects. Used in
      tests/PinballWizard.Web.Tests/A11y/ to assert WCAG 2.1 AA compliance
      on every public route via a real Chromium browser.
    -->
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.10.0" />
  </ItemGroup>
  <ItemGroup Label="Tests — xUnit + NSubstitute + bUnit + test SDK">
    <PackageVersion Include="bunit" Version="2.7.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <!--
      System.Security.Cryptography.Xml 9.0.0 has two high-severity vulns
      (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf). Still pulled transitively
      by bunit 2.x. Direct-pin to safe version.
    -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.7" />
    <!--
      Microsoft.AspNetCore.TestHost enables in-process TestServer testing
      for WizardAskStreamEndpointTests (Wave 1 PR-F2). Version matches
      ASP.NET Core / .NET 10 GA train.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.7" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup Label="Web — Blazor frontend (ADR-0026) + Entra External ID auth (ADR-0009)">
    <!--
      MudBlazor 8.x targets .NET 8+. 8.5.0 is the current GA that
      supports .NET 10 via the .NET 8 TFM forward-compat path.
      Pin to a specific minor so template / theme shape is reproducible.
      Bump in a dedicated Dependabot PR.
    -->
    <PackageVersion Include="MudBlazor" Version="8.5.0" />
    <!--
      Microsoft.Identity.Web 3.x is the first release to support
      Entra External ID tenants natively per ADR-0009. 3.8.4 is the
      current GA; bump via Dependabot.
    -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="3.8.4" />
    <PackageVersion Include="Microsoft.Identity.Web.UI" Version="3.8.4" />
    <!--
      Blazor auto-render mode (ADR-0026 § 1) requires the WASM runtime
      in the Client project and the WASM static-asset server in the
      Server project. Both match the ASP.NET Core / .NET 10 GA train.
      Microsoft.AspNetCore.Components.WebAssembly is NOT implicit in
      the BlazorWebAssembly SDK — it must be an explicit reference.
      Microsoft.AspNetCore.Components.WebAssembly.Server must be
      referenced by the Server (PinballWizard.Web) so Kestrel serves
      the WASM bootstrap and static framework files.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.7" />
  </ItemGroup>
</Project>
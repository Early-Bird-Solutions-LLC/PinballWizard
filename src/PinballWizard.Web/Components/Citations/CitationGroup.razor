@* CitationGroup — renders all citations from a single source-URL host.
 *
 * One of the locked CitationStrip delight surface family (ADR-0026 § 6).
 *
 * Behavior:
 *   - Citations are sorted by RelevanceScore descending (nulls last).
 *   - ALL citations render full-fidelity — no disclosure toggle, no collapse.
 *     Per modern-lcd.md "Many-citations behavior" and FE-09 (citation-as-hero):
 *     the card stack stays uncollapsed; we resist walling content behind
 *     disclosures that hide the path out.
 *
 * ADR-0026 § 4 — citation grouping UX
 * ADR-0008     — MudBlazor strict
 *@

@using PinballWizard.Application.Ai

@{
    var sorted = SortedCitations(Citations);
}

<div class="citation-group"
     data-testid="citation-group"
     data-host="@Host">

    <MudStack Spacing="1" Style="flex:1">

        @* Host label row *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Public"
                     Size="Size.Small"
                     Color="Color.Secondary" />
            <MudText Typo="Typo.caption"
                     Color="Color.Secondary"
                     Style="font-family: var(--pw-font-mono);"
                     Class="citation-group-host">
                @Host
            </MudText>
        </MudStack>

        @* All citations, full-fidelity, sorted by relevance score descending.
         * Ordinal is 1-based across the strip; StartOrdinal carries the running
         * offset from CitationStrip so each card gets a unique citation-{N} id.
         * MarkedOrdinals (from CitationStrip) lights the left flipper on cards
         * whose ordinal appears as [[cite:N]] in the answer body. *@
        @for (var i = 0; i < sorted.Count; i++)
        {
            var ordinal = StartOrdinal + i + 1;
            <CitationCard Citation="@sorted[i]"
                          Ordinal="@ordinal"
                          HasInlineMarker="@(MarkedOrdinals?.Contains(ordinal) ?? false)" />
        }

    </MudStack>
</div>

@code {
    [Parameter, EditorRequired]
    public string Host { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<Citation> Citations { get; set; } = [];

    /// <summary>
    /// Running ordinal offset from CitationStrip. The first card in this group
    /// gets ordinal StartOrdinal + 1; each subsequent card increments by 1.
    /// </summary>
    [Parameter]
    public int StartOrdinal { get; set; }

    /// <summary>
    /// Set of ordinals (1-based, strip-global) that appear as [[cite:N]] in the
    /// answer body. Cards whose ordinal is in this set render the left flipper
    /// (◀ VIEW IN ANSWER). Null or empty means no flippers are lit.
    /// </summary>
    [Parameter]
    public HashSet<int>? MarkedOrdinals { get; set; }

    // Internal so tests can validate ordering logic independently.
    internal static IReadOnlyList<Citation> SortedCitations(IReadOnlyList<Citation> citations) =>
        [.. citations.OrderByDescending(c => c.RelevanceScore ?? double.MinValue)];
}

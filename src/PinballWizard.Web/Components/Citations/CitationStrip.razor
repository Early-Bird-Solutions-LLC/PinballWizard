@* CitationStrip — top-level citation surface for a WizardAnswer.
 *
 * One of the four locked delight surfaces per ADR-0026 § 6:
 *   WizardAnswerStream | RefusalPanel | CitationStrip family | TiltPage/TiltErrorBoundary
 *
 * Layout:
 *   Mobile  (<960px) — vertical stack of CitationGroup components.
 *   Desktop (≥960px) — horizontal scrollable strip.
 *   Switched via CSS media query (CitationStrip.razor.css), deliberately NOT
 *   MudHidden: MudHidden resolves its breakpoint through an async JS interop
 *   roundtrip per instance, so on fast (cache-hit) answers the citation cards
 *   appeared seconds AFTER the answer — the user saw a "Sources" header with
 *   no sources, and the E2E citation assertion raced it (2026-06-11, #364).
 *   CSS evaluates synchronously with first paint; the cards exist in the DOM
 *   the moment the strip renders. 960px matches MudBlazor's md breakpoint.
 *
 * Ordering: groups sorted by max RelevanceScore of their citations, descending.
 * Null scores sort last (score treated as double.MinValue for ordering only).
 *
 * Provenance (guardrails.md goal #5 + ADR-0026 § 8):
 *   Every Citation in the list must be resolvable to a real SourceUrl. This
 *   component renders SourceUrl directly — there is no interstitial. If SourceUrl
 *   is empty the CitationCard still renders the link element with an empty href;
 *   the caller (AiRouter / ToolTraceCitationExtractor) is responsible for
 *   guaranteeing non-empty SourceUrl per the Citation contract.
 *
 * Community-resource posture (feedback_community_resource_posture.md):
 *   All citation links route to external source sites. No PinballWizard
 *   interstitial — traffic goes OUT.
 *
 * ADR-0026 § 4, § 6 — citation surface UX, delight surface lock
 * ADR-0023          — citation-required guardrail feeds this component
 * ADR-0008          — MudBlazor strict
 *@

@using PinballWizard.Application.Ai

@if (Citations is not null && Citations.Count > 0)
{
    var groups      = BuildGroups(Citations);
    var citedLabel  = Citations.Count == 1 ? "1 cited" : $"{Citations.Count} cited";
    var sitesLabel  = groups.Count  == 1 ? "1 site"  : $"{groups.Count} sites";
    var summaryText = $"SOURCES · {citedLabel} from {sitesLabel}";

    // Card ordinals derive from the BuildGroups loop below (running `ordinal`
    // counter). CitationOrdering.InRenderOrder delegates to BuildGroups and
    // flattens, so card N and the cascaded tooltip N agree by construction
    // (InRenderOrder_matches_card_ordinal_order asserts this).
    var marked  = MarkedOrdinals();

    // Running offset into the ordered list: each group claims a slice.
    var ordinal = 0;

    <div class="citation-strip"
         data-testid="citation-strip"
         aria-label="Sources">

        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="citation-strip-label mb-2">
            @summaryText
        </MudText>

        @* Single render of the groups; the layout flips column↔row purely in
           CSS (CitationStrip.razor.css) so no JS roundtrip gates visibility. *@
        <div class="citation-strip-layout">
            @foreach (var group in groups)
            {
                // Build the set of marked ordinals within this group's slice.
                var groupSize       = group.Citations.Count;
                var groupStartOrdinal = ordinal;
                HashSet<int> groupMarked = [];
                for (var i = 0; i < groupSize; i++)
                {
                    var n = groupStartOrdinal + i + 1;
                    if (marked.Contains(n))
                        groupMarked.Add(n);
                }

                <div class="citation-strip-group">
                    <CitationGroup Host="@group.Host"
                                   Citations="@group.Citations"
                                   StartOrdinal="@ordinal"
                                   MarkedOrdinals="@groupMarked" />
                </div>
                ordinal += groupSize;
            }
        </div>

    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Citation> Citations { get; set; } = [];

    /// <summary>
    /// The full rendered answer text. When provided, CitationStrip scans it
    /// for <c>[[cite:N]]</c> markers and lights the left flipper on matching cards.
    /// </summary>
    [Parameter]
    public string? AnswerBody { get; set; }

    private static readonly System.Text.RegularExpressions.Regex CiteN =
        new(@"\[\[cite:(\d+)\]\]", System.Text.RegularExpressions.RegexOptions.Compiled);

    private HashSet<int> MarkedOrdinals()
        => AnswerBody is null ? []
           : [.. CiteN.Matches(AnswerBody).Select(m => int.Parse(m.Groups[1].Value))];

    // Exposed as internal for test access to grouping + ordering logic.
    internal record CitationGroupModel(string Host, IReadOnlyList<Citation> Citations);

    internal static IReadOnlyList<CitationGroupModel> BuildGroups(IReadOnlyList<Citation> citations)
    {
        return citations
            .GroupBy(c => ExtractHost(c.SourceUrl))
            .Select(g => new CitationGroupModel(
                Host: g.Key,
                Citations: [.. g]))
            .OrderByDescending(g => g.Citations.Max(c => c.RelevanceScore ?? double.MinValue))
            .ToList();
    }

    private static string ExtractHost(string sourceUrl)
    {
        if (string.IsNullOrWhiteSpace(sourceUrl))
            return "(unknown source)";

        if (Uri.TryCreate(sourceUrl, UriKind.Absolute, out var uri))
            return uri.Host;

        return sourceUrl;
    }
}

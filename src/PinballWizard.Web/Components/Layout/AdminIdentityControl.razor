@using Microsoft.AspNetCore.Components.Authorization
@using PinballWizard.Web.Security
@inject NavigationManager Nav

@* Admin app-bar identity control. Anchor-only (no @onclick / @rendermode) so it
 * never perturbs admin page circuits (interactive-island-in-static-layout).
 * Sign-in/out route through the Microsoft.Identity.Web AccountController via AdminSignIn.
 *
 * data-enhance-nav="false" on both anchors is load-bearing: blazor.web.js enhanced
 * navigation intercepts same-origin anchor clicks and services them via fetch + DOM
 * patch. The AccountController responds with a cross-origin 302 to Entra, which
 * enhanced navigation cannot apply — the URL changed to the SignIn endpoint but the
 * browser never left for the IdP, so "Sign in" appeared to do nothing. Opting out
 * forces a real full-page navigation that follows the redirect. Same fix as
 * TiltErrorBoundary's recover link. *@

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.caption" Class="mr-2" data-testid="admin-identity">
            Signed in as @DisplayName(context)
        </MudText>
        <MudButton Href="@AdminSignIn.SignOutPath"
                   data-enhance-nav="false"
                   Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Logout" data-testid="admin-signout">
            Sign out
        </MudButton>
    </Authorized>
    <NotAuthorized>
        <MudButton Href="@AdminSignIn.Href(ReturnUrl)"
                   data-enhance-nav="false"
                   Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Login" data-testid="admin-signin">
            Sign in
        </MudButton>
    </NotAuthorized>
</AuthorizeView>

@code {
    // Current local path so sign-in returns the user to the page they were on.
    private string ReturnUrl => "/" + Nav.ToBaseRelativePath(Nav.Uri);

    // Microsoft.Identity.Web maps Identity.Name to the preferred_username claim
    // (non-B2C default), which Entra External ID (CIAM, ADR-0009) doesn't always
    // populate for every account — leaving Identity.Name null/empty even though
    // the user is authenticated. AdminSettings.ResolveUpdatedByAsync already
    // anticipates this same gap for the audit-trail field; mirror its fallback
    // here so the app bar never renders "Signed in as" with nothing after it.
    private static string DisplayName(AuthenticationState state)
    {
        var name = state.User.Identity?.Name;
        return string.IsNullOrWhiteSpace(name) ? "admin (authenticated, no name claim)" : name;
    }
}

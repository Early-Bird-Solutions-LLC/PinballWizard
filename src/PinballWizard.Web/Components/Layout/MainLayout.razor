@* MainLayout — public Wizard surface chrome.
 *
 * Replaces the PR-F0 placeholder. Wraps @Body with the full MudBlazor
 * chrome: theme tokens, MudLayout, MudAppBar (BrandHeader), MudMainContent.
 * TiltErrorBoundary wraps @Body so any unhandled render exception displays
 * the pinball-themed TILT message instead of the framework default.
 *
 * Category: chrome wrapper — all layout primitives are MudBlazor (MudLayout,
 * MudAppBar, MudMainContent). Not a custom delight surface in the
 * ADR-0026 § 6 sense; serves as the public chrome container.
 *
 * AdminLayout uses a separate layout declared explicitly via @layout on each
 * /admin/* page — no pages in Wave 1 use AdminLayout.
 *
 * ADR-0008  — MudBlazor strict for all chrome
 * ADR-0026  § 1, § 6 — auto-render mode + component strategy
 *@

@inherits LayoutComponentBase

@using PinballWizard.Web.Components.Theming
@using PinballWizard.Web.Components.Degraded

@* The MudBlazor providers MUST render in an interactive render mode. This
 * layout is static (LayoutComponentBase), and pages opt into interactivity
 * per-page (@rendermode InteractiveServer on Index/Wizard/etc. — #347 kept
 * static pages like About static, so global interactivity is not an option).
 * A statically-rendered MudPopoverProvider cannot serve a popover (MudTooltip,
 * MudMenu, …) that lives in an interactive page island → the circuit crashes
 * with "Missing <MudPopoverProvider />". Pinning the providers to
 * InteractiveServer makes them interactive islands within this static layout;
 * Blazor Server shares one circuit per page, so the scoped popover/dialog/
 * snackbar services + host elements are shared with the interactive pages.
 * Static pages stay static (they render no popovers, so they never reach the
 * providers). The theme provider prerenders its CSS, so no FOUC. *@
<MudThemeProvider @rendermode="InteractiveServer" Theme="@_theme" IsDarkMode="true" />
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudLayout>
    <MudAppBar Elevation="1">
        <BrandHeader />
        @* SoundController: muted-by-default audio toggle per ADR-0026 § "Explicitly NOT adopted".
           Right-side header placement. No audio plays in this PR — toggle infrastructure only. *@
        <SoundController />
    </MudAppBar>

    @* OutageBanner: shown when IClientDegradationStore carries a non-None mode.
       Hidden by default. Positioned above MudMainContent so it spans full width
       without competing with the AppBar chrome above or the page content below. *@
    <OutageBanner />

    <AppNavRail @rendermode="InteractiveServer"
                Open="false"
                HoverToPeek="true"
                Persist="true"
                Breakpoint="Breakpoint.None"
                HeaderText="PinballWizard"
                Items="@PublicNav" />

    <MudMainContent>
        <TiltErrorBoundary>
            @Body
        </TiltErrorBoundary>
    </MudMainContent>

    <BrandFooter />
</MudLayout>

@code {
    private readonly MudTheme _theme = PinballTheme.Create();

    private static readonly IReadOnlyList<NavRailItem> PublicNav = new[]
    {
        new NavRailItem("/", "Ask the Wizard", Icons.Material.Filled.AutoAwesome, MatchAll: true),
        new NavRailItem("/about", "What we cover", Icons.Material.Filled.Explore),
        new NavRailItem("/documents", "Documents", Icons.Material.Filled.Article),
        new NavRailItem("/admin", "Behind the Scenes", Icons.Material.Filled.Visibility),
    };
}

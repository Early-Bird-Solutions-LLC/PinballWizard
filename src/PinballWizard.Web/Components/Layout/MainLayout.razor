@* MainLayout — public Wizard surface chrome.
 *
 * Replaces the PR-F0 placeholder. Wraps @Body with the full MudBlazor
 * chrome: theme tokens, MudLayout, MudAppBar (BrandHeader), MudMainContent.
 * TiltErrorBoundary wraps @Body so any unhandled render exception displays
 * the pinball-themed TILT message instead of the framework default.
 *
 * Category: chrome wrapper — all layout primitives are MudBlazor (MudLayout,
 * MudAppBar, MudMainContent). Not a custom delight surface in the
 * ADR-0026 § 6 sense; serves as the public chrome container.
 *
 * AdminLayout uses a separate layout declared explicitly via @layout on each
 * /admin/* page — no pages in Wave 1 use AdminLayout.
 *
 * ADR-0008  — MudBlazor strict for all chrome
 * ADR-0026  § 1, § 6 — auto-render mode + component strategy
 *@

@inherits LayoutComponentBase

@using PinballWizard.Web.Components.Theming
@using PinballWizard.Web.Components.Degraded

<MudThemeProvider Theme="@_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <BrandHeader />
        @* SoundController: muted-by-default audio toggle per ADR-0026 § "Explicitly NOT adopted".
           Right-side header placement. No audio plays in this PR — toggle infrastructure only. *@
        <SoundController />
    </MudAppBar>

    @* OutageBanner: shown when IClientDegradationStore carries a non-None mode.
       Hidden by default. Positioned above MudMainContent so it spans full width
       without competing with the AppBar chrome above or the page content below. *@
    <OutageBanner />

    <MudMainContent>
        <TiltErrorBoundary>
            @Body
        </TiltErrorBoundary>
    </MudMainContent>

    <BrandFooter />
</MudLayout>

@code {
    private readonly MudTheme _theme = PinballTheme.Create();
}

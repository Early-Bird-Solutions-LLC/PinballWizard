@* AppNavRail — shared left navigation rail.
 *
 * Two hosting modes:
 *   1. Collapsible (ShowToggle=true, default) — a MudDrawer Mini rail with an
 *      in-rail toggle button. Because the toggle has an @onclick, the host layout
 *      MUST set @rendermode="InteractiveServer" on the <AppNavRail> tag so the
 *      click is live (the component cannot self-enforce that). Used by MainLayout
 *      (public, default collapsed).
 *      Opt-in enhancements (all default false, admin rail unaffected):
 *        HoverToPeek  — pointer-enter peeks the rail open when not pinned;
 *                       pointer-leave retracts. Guard: no-op when already pinned.
 *        Persist/PersistKey — pin state is persisted to localStorage under
 *                       PersistKey (default "pinwiz.nav.pinned") and restored on
 *                       first render. No JS calls when Persist=false.
 *        Breakpoint   — forwarded to MudDrawer (default Md; set None to keep
 *                       the rail visible at all viewport widths).
 *   2. Static always-expanded (ShowToggle=false) — no toggle, no @onclick, so the
 *      rail is pure static markup (anchors only) and needs NO @rendermode. Used by
 *      AdminLayout, whose /admin/* pages run their own interactive circuits; a
 *      zero-@onclick layout subtree keeps the rail's interactivity profile
 *      identical to the previous inline admin drawer.
 *
 *      Opt-in CSS/JS collapse (ShowCollapseToggle=true, default false):
 *        Adds a plain HTML <button> to the rail header — NOT a MudIconButton, and
 *        NOT wired with @onclick. The button is wired entirely by the vanilla JS
 *        module wwwroot/js/admin-nav-collapse.js, which toggles the
 *        pw-admin-nav--collapsed class on <html> and persists to localStorage
 *        (key: pinwiz.admin.nav.collapsed). Using a plain <button> preserves the
 *        static circuit profile — the "hamburger bug" is specifically a Blazor
 *        @onclick on the admin chrome; a plain HTML button is invisible to Blazor.
 *        Spec: docs/superpowers/specs/2026-07-07-admin-consistency-design.md §5.1
 *
 * Footer slot (optional): a RenderFragment pinned to the drawer bottom via CSS
 * flex column. When null (the default) no extra DOM is emitted and the public
 * rail layout is unchanged. AdminLayout populates it with AdminStatusFooter.
 *
 * Design: docs/superpowers/specs/2026-07-01-public-left-nav-design.md
 *         docs/superpowers/specs/2026-07-01-public-nav-rail-enhancements-design.md
 * ADR-0008 — MudBlazor strict.
 *@
@inject Microsoft.JSInterop.IJSRuntime JS

<MudDrawer Open="@IsOpen"
           Variant="DrawerVariant.Mini"
           Breakpoint="@Breakpoint"
           Elevation="2"
           Class="@DrawerClass"
           aria-label="@(IsOpen ? HeaderText : "Navigation")"
           @onpointerenter="OnPointerEnter"
           @onpointerleave="OnPointerLeave">
    <MudDrawerHeader Class="d-flex align-center pa-2">
        @if (ShowToggle)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           OnClick="Toggle"
                           data-testid="nav-rail-toggle"
                           aria-label="@(_pinned ? "Collapse navigation" : (_peek ? "Pin navigation" : "Expand navigation"))"
                           title="@(_pinned ? "Collapse navigation" : (_peek ? "Pin navigation" : "Expand navigation"))" />
        }
        @if (ShowCollapseToggle)
        {
            @* CSS/JS collapse toggle — plain <button>, no @onclick.
               MudIconButton is intentionally NOT used here: its OnClick parameter
               wires a Blazor @onclick, which would require @rendermode on the admin
               chrome and break the admin circuit profile (the "hamburger bug").
               This plain <button> is wired entirely by admin-nav-collapse.js. *@
            <button class="pw-admin-collapse-toggle"
                    type="button"
                    data-testid="admin-nav-collapse-toggle"
                    aria-label="Collapse navigation"
                    aria-expanded="true"
                    title="Collapse navigation">
                <MudIcon Icon="@Icons.Material.Filled.Menu" aria-hidden="true" />
            </button>
        }
        @if (IsOpen)
        {
            <MudText Typo="Typo.subtitle1" Class="@HeaderTextCssClass">@HeaderText</MudText>
        }
    </MudDrawerHeader>

    <MudNavMenu>
        @foreach (var item in Items)
        {
            @* aria-label is deliberately NOT passed here. MudNavLink splats user
               attributes onto its wrapper <div class="mud-nav-item">, not onto the
               <a> — so the aria-label that used to sit here landed on a role-less
               div, where ARIA prohibits it (axe: aria-prohibited-attr), and it never
               named the link it was meant to name. title stays: it is valid on a div
               and still supplies the hover tooltip. *@
            <MudNavLink Href="@item.Href"
                        Match="@(item.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                        Icon="@item.Icon"
                        title="@item.Label">
                @* This label is the link's ONLY accessible name, and in the rail's
                   default collapsed state it was reaching screen readers as nothing
                   at all (axe: link-name) — the exact failure the old comment here
                   claimed title + aria-label prevented. MudBlazor wraps ChildContent
                   in <div class="mud-nav-link-text"> and sets display:none on it in
                   the mini drawer, which drops the subtree out of the accessibility
                   tree entirely. The fix is the collapsed-rail rule in app.css, which
                   swaps that display:none for a screen-reader-only treatment; nothing
                   here can compensate for it, because any markup added inside
                   ChildContent is hidden by the same rule. *@
                <span class="pw-nav-label">@item.Label</span>
            </MudNavLink>
        }
    </MudNavMenu>

    @* Footer slot: pinned to drawer bottom via app-nav-rail flex-column CSS.
       Only emits DOM when a Footer is provided — public rail is unaffected. *@
    @if (Footer is not null)
    {
        <div class="app-nav-rail__footer" data-testid="nav-rail-footer-slot">
            @Footer
        </div>
    }
</MudDrawer>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<NavRailItem> Items { get; set; } = Array.Empty<NavRailItem>();
    [Parameter] public bool Open { get; set; }
    [Parameter] public string HeaderText { get; set; } = "Navigation";

    // When false, the rail renders no toggle button (no @onclick) and stays at
    // whatever Open state it was given — a pure static rail that needs no
    // @rendermode on the host. See the file header for the two hosting modes.
    [Parameter] public bool ShowToggle { get; set; } = true;

    // When true, renders a plain HTML <button> (NOT a MudIconButton — no @onclick)
    // whose click is wired by wwwroot/js/admin-nav-collapse.js. The button toggles
    // the pw-admin-nav--collapsed class on <html> and persists state to localStorage.
    // Designed for AdminLayout where the rail must remain static (no @rendermode).
    // Default false so the public MainLayout rail is completely unaffected.
    [Parameter] public bool ShowCollapseToggle { get; set; }

    [Parameter] public Breakpoint Breakpoint { get; set; } = Breakpoint.Md;

    // When true, pointer-enter peeks the rail open (only if not pinned);
    // pointer-leave retracts. Default false so the static admin rail is unaffected.
    [Parameter] public bool HoverToPeek { get; set; }

    // When true, the pinned state is persisted to localStorage under PersistKey.
    // Default false — admin rail and any static rail are unaffected (no JS calls).
    [Parameter] public bool Persist { get; set; }
    [Parameter] public string PersistKey { get; set; } = "pinwiz.nav.pinned";

    // Optional content pinned to the drawer bottom. Null by default so the
    // public MainLayout rail is completely unaffected — no extra DOM, no layout
    // change. AdminLayout populates this with <AdminStatusFooter />.
    [Parameter] public RenderFragment? Footer { get; set; }

    private bool _pinned;
    private bool _peek;

    private bool IsOpen => _pinned || _peek;

    // CSS class string for the MudDrawer. The 'app-nav-rail--collapsible' modifier
    // is added when ShowCollapseToggle is active so the JS module and CSS rules
    // can target the admin rail specifically without affecting the public rail.
    private string DrawerClass =>
        ShowCollapseToggle ? "app-nav-rail app-nav-rail--collapsible" : "app-nav-rail";

    // CSS class for the header text element. ml-2 adds left margin when a button
    // sits to the left (either the Blazor toggle or the CSS/JS collapse button).
    // pw-nav-header-text is targeted by the CSS collapse rule to hide the label.
    private string HeaderTextCssClass =>
        (ShowToggle || ShowCollapseToggle) ? "ml-2 pw-nav-header-text" : "pw-nav-header-text";

    protected override void OnInitialized() => _pinned = Open;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Persist)
        {
            var stored = await NavRailStorage.GetPinnedAsync(JS, PersistKey);
            if (stored.HasValue && stored.Value != _pinned)
            {
                _pinned = stored.Value;
                StateHasChanged();
            }
        }
    }

    private async Task Toggle()
    {
        _pinned = !_pinned;
        if (Persist) await NavRailStorage.SetPinnedAsync(JS, PersistKey, _pinned);
    }

    private void OnPointerEnter()
    {
        if (HoverToPeek && !_pinned) _peek = true;
    }

    private void OnPointerLeave()
    {
        if (HoverToPeek && _peek) _peek = false;
    }
}

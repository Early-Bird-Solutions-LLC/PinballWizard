@* AppNavRail — shared left navigation rail.
 *
 * Two hosting modes:
 *   1. Collapsible (ShowToggle=true, default) — a MudDrawer Mini rail with an
 *      in-rail toggle button. Because the toggle has an @onclick, the host layout
 *      MUST set @rendermode="InteractiveServer" on the <AppNavRail> tag so the
 *      click is live (the component cannot self-enforce that). Used by MainLayout
 *      (public, default collapsed).
 *      Opt-in enhancements (all default false, admin rail unaffected):
 *        HoverToPeek  — pointer-enter peeks the rail open when not pinned;
 *                       pointer-leave retracts. Guard: no-op when already pinned.
 *        Persist/PersistKey — pin state is persisted to localStorage under
 *                       PersistKey (default "pinwiz.nav.pinned") and restored on
 *                       first render. No JS calls when Persist=false.
 *        Breakpoint   — forwarded to MudDrawer (default Md; set None to keep
 *                       the rail visible at all viewport widths).
 *   2. Static always-expanded (ShowToggle=false) — no toggle, no @onclick, so the
 *      rail is pure static markup (anchors only) and needs NO @rendermode. Used by
 *      AdminLayout, whose /admin/* pages run their own interactive circuits; a
 *      zero-@onclick layout subtree keeps the rail's interactivity profile
 *      identical to the previous inline admin drawer.
 *
 * Design: docs/superpowers/specs/2026-07-01-public-left-nav-design.md
 *         docs/superpowers/specs/2026-07-01-public-nav-rail-enhancements-design.md
 * ADR-0008 — MudBlazor strict.
 *@
@inject Microsoft.JSInterop.IJSRuntime JS

<MudDrawer Open="@IsOpen"
           Variant="DrawerVariant.Mini"
           Breakpoint="@Breakpoint"
           Elevation="2"
           Class="app-nav-rail"
           aria-label="@(IsOpen ? HeaderText : "Navigation")"
           @onpointerenter="OnPointerEnter"
           @onpointerleave="OnPointerLeave">
    <MudDrawerHeader Class="d-flex align-center pa-2">
        @if (ShowToggle)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           OnClick="Toggle"
                           data-testid="nav-rail-toggle"
                           aria-label="@(_pinned ? "Collapse navigation" : (_peek ? "Pin navigation" : "Expand navigation"))"
                           title="@(_pinned ? "Collapse navigation" : (_peek ? "Pin navigation" : "Expand navigation"))" />
        }
        @if (IsOpen)
        {
            <MudText Typo="Typo.subtitle1" Class="@(ShowToggle ? "ml-2" : null)">@HeaderText</MudText>
        }
    </MudDrawerHeader>

    <MudNavMenu>
        @foreach (var item in Items)
        {
            <MudNavLink Href="@item.Href"
                        Match="@(item.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                        Icon="@item.Icon"
                        title="@item.Label"
                        aria-label="@item.Label">
                @item.Label
            </MudNavLink>
        }
    </MudNavMenu>
</MudDrawer>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<NavRailItem> Items { get; set; } = Array.Empty<NavRailItem>();
    [Parameter] public bool Open { get; set; }
    [Parameter] public string HeaderText { get; set; } = "Navigation";

    // When false, the rail renders no toggle button (no @onclick) and stays at
    // whatever Open state it was given — a pure static rail that needs no
    // @rendermode on the host. See the file header for the two hosting modes.
    [Parameter] public bool ShowToggle { get; set; } = true;

    [Parameter] public Breakpoint Breakpoint { get; set; } = Breakpoint.Md;

    // When true, pointer-enter peeks the rail open (only if not pinned);
    // pointer-leave retracts. Default false so the static admin rail is unaffected.
    [Parameter] public bool HoverToPeek { get; set; }

    // When true, the pinned state is persisted to localStorage under PersistKey.
    // Default false — admin rail and any static rail are unaffected (no JS calls).
    [Parameter] public bool Persist { get; set; }
    [Parameter] public string PersistKey { get; set; } = "pinwiz.nav.pinned";

    private bool _pinned;
    private bool _peek;

    private bool IsOpen => _pinned || _peek;

    protected override void OnInitialized() => _pinned = Open;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Persist)
        {
            var stored = await NavRailStorage.GetPinnedAsync(JS, PersistKey);
            if (stored.HasValue && stored.Value != _pinned)
            {
                _pinned = stored.Value;
                StateHasChanged();
            }
        }
    }

    private async Task Toggle()
    {
        _pinned = !_pinned;
        if (Persist) await NavRailStorage.SetPinnedAsync(JS, PersistKey, _pinned);
    }

    private void OnPointerEnter()
    {
        if (HoverToPeek && !_pinned) _peek = true;
    }

    private void OnPointerLeave()
    {
        if (HoverToPeek && _peek) _peek = false;
    }
}

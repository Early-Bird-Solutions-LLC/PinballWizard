@* AdminLayout — admin chrome with drawer navigation.
 *
 * Used exclusively by /admin/* pages that declare @layout AdminLayout.
 * No /admin/* pages exist in Wave 1 — the layout is scaffolded so the
 * Entra External ID auth wiring has a target once that PR lands.
 *
 * [Authorize] is present here and on /admin/* pages. The AzureAd
 * appsettings are intentionally empty in Wave 1 — real tenant config
 * arrives in the Entra follow-up PR. Until then, any visit to an
 * admin route will fail the auth challenge (which is correct behavior).
 *
 * Category: chrome wrapper — all layout primitives are MudBlazor (MudLayout,
 * MudAppBar, MudDrawer, MudNavMenu, MudMainContent). Not a custom delight
 * surface in the ADR-0026 § 6 sense.
 *
 * ADR-0008  — MudBlazor strict for all chrome
 * ADR-0009  — Entra External ID admin RBAC v1
 * ADR-0026  § 1 — routing inventory (/admin auth)
 *@

@inherits LayoutComponentBase

@using PinballWizard.Web.Components.Theming

@* The MudBlazor providers are pinned to InteractiveServer — identical to
 * MainLayout. Admin is per-need render mode (ADR-0034 amendment, 2026-06-17):
 * the interactive /admin/* pages (Settings, Triage, LinkOverrides, Machines,
 * MachineDetail) resolve IPopoverService/IDialogService/ISnackbar from these
 * providers on the shared circuit. A static provider here would crash an
 * interactive admin page with "Missing <MudPopoverProvider />" (the inverse of
 * the PR #401 outage). Static admin pages (Dashboard, Sources) render no
 * popovers, so the interactive providers are a no-op for them. *@
<MudThemeProvider @rendermode="InteractiveServer" Theme="@_theme" IsDarkMode="true" />
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer"
                       aria-label="Toggle navigation drawer" />

        <MudText Typo="Typo.h6" Class="ml-2">
            PinballWizard Admin
        </MudText>

        <MudSpacer />

        <MudButton Href="/"
                   Variant="Variant.Text"
                   Color="Color.Inherit"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Size="Size.Small">
            Back to Wizard
        </MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Temporary"
               Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle1" Class="mt-1">Admin Navigation</MudText>
        </MudDrawerHeader>

        <MudNavMenu>
            <MudNavLink Href="/admin"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
            <MudNavLink Href="/admin/sources"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Source">
                Sources
            </MudNavLink>
            <MudNavLink Href="/admin/machines"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.SportsBaseball">
                Machines
            </MudNavLink>
            <MudNavLink Href="/admin/document-triage"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.RuleFolder">
                Document Triage
            </MudNavLink>
            <MudNavLink Href="/admin/link-overrides"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.LinkOff">
                Link Overrides
            </MudNavLink>
            <MudNavLink Href="/admin/settings"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Tune">
                Settings
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <TiltErrorBoundary>
            @Body
        </TiltErrorBoundary>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;
    private readonly MudTheme _theme = PinballTheme.Create();

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}

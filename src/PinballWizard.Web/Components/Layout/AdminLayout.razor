@* AdminLayout — admin chrome with drawer navigation.
 *
 * Used exclusively by /admin/* pages that declare @layout AdminLayout.
 * Navigation is handled by the shared AppNavRail component (Open="true" so all
 * nine admin links are visible on load). The rail is pinned to InteractiveServer
 * so the toggle's @onclick is live even inside a statically-rendered layout
 * (mirrors the MudBlazor provider islands already in this file).
 *
 * [Authorize] is present here and on /admin/* pages. The AzureAd
 * appsettings are intentionally empty in Wave 1 — real tenant config
 * arrives in the Entra follow-up PR. Until then, any visit to an
 * admin route will fail the auth challenge (which is correct behavior).
 *
 * Category: chrome wrapper — all layout primitives are MudBlazor (MudLayout,
 * MudAppBar, MudMainContent) plus the shared AppNavRail. Not a custom delight
 * surface in the ADR-0026 § 6 sense.
 *
 * ADR-0008  — MudBlazor strict for all chrome
 * ADR-0009  — Entra External ID admin RBAC v1
 * ADR-0026  § 1 — routing inventory (/admin auth)
 *@

@inherits LayoutComponentBase

@using PinballWizard.Web.Components.Theming
@using Microsoft.AspNetCore.Components.Authorization

@* The MudBlazor providers are pinned to InteractiveServer — identical to
 * MainLayout. Admin is per-need render mode (ADR-0034 amendment, 2026-06-17):
 * the interactive /admin/* pages (Settings, Triage, LinkOverrides, Machines,
 * MachineDetail) resolve IPopoverService/IDialogService/ISnackbar from these
 * providers on the shared circuit. A static provider here would crash an
 * interactive admin page with "Missing <MudPopoverProvider />" (the inverse of
 * the PR #401 outage). Static admin pages (Dashboard, Sources) render no
 * popovers, so the interactive providers are a no-op for them. *@
<MudThemeProvider @rendermode="InteractiveServer" Theme="@_theme" IsDarkMode="true" />
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6" Class="ml-2">
            PinballWizard Admin
        </MudText>

        <MudSpacer />

        <MudButton Href="/"
                   Variant="Variant.Text"
                   Color="Color.Inherit"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Size="Size.Small">
            Back to Wizard
        </MudButton>
    </MudAppBar>

    <AppNavRail @rendermode="InteractiveServer" Open="true" HeaderText="Admin Navigation" Items="@AdminNav" />

    <MudMainContent>
        <AuthorizeView>
            <Authorized>
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="ma-2" Spacing="2">
                    <MudText Typo="Typo.caption" data-testid="admin-identity">
                        Signed in as @context.User.Identity?.Name
                    </MudText>
                    <MudLink Href="/MicrosoftIdentity/Account/SignOut" Typo="Typo.caption">Sign out</MudLink>
                </MudStack>
            </Authorized>
        </AuthorizeView>
        <TiltErrorBoundary>
            @Body
        </TiltErrorBoundary>
    </MudMainContent>
    @* No <BrandFooter /> — admin is a utility/console surface; the public brand footer is not part of admin chrome. *@
</MudLayout>

@code {
    private readonly MudTheme _theme = PinballTheme.Create();

    private static readonly IReadOnlyList<NavRailItem> AdminNav =
    [
        new NavRailItem("/admin",                 "Dashboard",       Icons.Material.Filled.Dashboard,    MatchAll: true),
        new NavRailItem("/admin/sources",         "Sources",         Icons.Material.Filled.Source),
        new NavRailItem("/admin/machines",        "Machines",        Icons.Material.Filled.SportsBaseball),
        new NavRailItem("/admin/documents",       "Documents",       Icons.Material.Filled.Article),
        new NavRailItem("/admin/document-triage", "Document Triage", Icons.Material.Filled.RuleFolder),
        new NavRailItem("/admin/link-overrides",  "Link Overrides",  Icons.Material.Filled.LinkOff),
        new NavRailItem("/admin/jobs",            "Jobs",            Icons.Material.Filled.Schedule),
        new NavRailItem("/admin/monitoring",      "Monitoring",      Icons.Material.Filled.Monitor),
        new NavRailItem("/admin/settings",        "Settings",        Icons.Material.Filled.Tune),
    ];
}

@* BrandFooter — chrome footer mounted by MainLayout after MudMainContent.
 *
 * Coverage-statement copy is locked from
 * docs/ui/screens/empty-landing.md § Section 4 and renders on every
 * screen per docs/ui/screens/answer-with-citations.md § Screen zones #5.
 *
 * ADR-0008      — MudBlazor strict (MudText + MudLink only)
 * ADR-0026 § 6  — chrome, not a delight surface
 * ADR-0027 § 1  — Status link lives here, not in prospect-facing header
 * ADR-0027 § 4  — coverage transparency surface
 *@

<footer class="brand-footer" aria-label="Site footer">
    @* ── Glow divider ──────────────────────────────────────────────────── *@
    <div class="brand-footer__glow-divider" aria-hidden="true"></div>

    <MudContainer MaxWidth="MaxWidth.Large" Class="brand-footer__container">

        @* ── Top row: tagline + link columns ───────────────────────────── *@
        <div class="brand-footer__top">
            <div class="brand-footer__brand-col">
                <MudText Typo="Typo.h6" Class="brand-footer__logo">
                    &#x25CF; PinballWizard
                </MudText>
                <MudText Typo="Typo.body2" Class="brand-footer__tagline">
                    Routes you to the source,<br />not away from it.
                </MudText>
            </div>

            <nav class="brand-footer__links" aria-label="Footer navigation">
                <div class="brand-footer__link-group">
                    <MudText Typo="Typo.overline" Class="brand-footer__link-heading">
                        Navigate
                    </MudText>
                    <MudLink Href="/"
                             Color="Color.Inherit"
                             Underline="Underline.Hover"
                             Class="brand-footer__link"
                             aria-label="Ask the Wizard">Ask the Wizard</MudLink>
                    <MudLink Href="/about"
                             Color="Color.Inherit"
                             Underline="Underline.Hover"
                             Class="brand-footer__link"
                             aria-label="What we cover">What We Cover</MudLink>
                    <MudLink Href="/documents"
                             Color="Color.Inherit"
                             Underline="Underline.Hover"
                             Class="brand-footer__link"
                             aria-label="Documents">Documents</MudLink>
                </div>

                <div class="brand-footer__link-group">
                    <MudText Typo="Typo.overline" Class="brand-footer__link-heading">
                        Resources
                    </MudText>
                    <MudLink Href="/status"
                             Color="Color.Inherit"
                             Underline="Underline.Hover"
                             Class="brand-footer__link"
                             aria-label="System status">System Status</MudLink>
                    <MudLink Href="/settings"
                             Color="Color.Inherit"
                             Underline="Underline.Hover"
                             Class="brand-footer__link"
                             aria-label="Settings">Settings</MudLink>
                </div>

                <div class="brand-footer__link-group">
                    <MudText Typo="Typo.overline" Class="brand-footer__link-heading">
                        Connect
                    </MudText>
                    <MudLink Href="https://github.com/Early-Bird-Solutions-LLC/PinballWizard"
                             Target="_blank"
                             Color="Color.Inherit"
                             Underline="Underline.Hover"
                             Class="brand-footer__link"
                             rel="noopener noreferrer"
                             aria-label="PinballWizard on GitHub">GitHub</MudLink>
                </div>
            </nav>
        </div>

        @* ── Coverage statement ────────────────────────────────────────── *@
        <div class="brand-footer__coverage">
            <div class="brand-footer__coverage-inner">
                <span class="brand-footer__coverage-dot" aria-hidden="true"></span>
                <MudText Typo="Typo.body2" Class="brand-footer__coverage-text">
                    The Wizard has first-party data on 8 active manufacturers, OPDB,
                    Kineticist, and Silverball Labs. Everything else routes to community resources.
                    <MudLink Href="/about"
                             Color="Color.Success"
                             Underline="Underline.Hover"
                             Class="brand-footer__coverage-link"
                             aria-label="What we cover">What we cover &rarr;</MudLink>
                </MudText>
            </div>
        </div>

        @* ── Bottom bar ────────────────────────────────────────────────── *@
        <div class="brand-footer__bottom">
            <MudText Typo="Typo.caption" Class="brand-footer__copyright">
                &copy; @DateTime.UtcNow.Year Early Bird Solutions LLC
            </MudText>
            <MudText Typo="Typo.caption" Class="brand-footer__meta-links">
                <MudLink Href="/about"
                         Color="Color.Inherit"
                         Underline="Underline.Hover"
                         Class="brand-footer__meta-link"
                         aria-label="About">About</MudLink>
                <span class="brand-footer__meta-sep" aria-hidden="true">·</span>
                <MudLink Href="/status"
                         Color="Color.Inherit"
                         Underline="Underline.Hover"
                         Class="brand-footer__meta-link"
                         aria-label="Status">Status</MudLink>
                <span class="brand-footer__meta-sep" aria-hidden="true">·</span>
                <MudLink Href="https://github.com/Early-Bird-Solutions-LLC/PinballWizard"
                         Target="_blank"
                         Color="Color.Inherit"
                         Underline="Underline.Hover"
                         Class="brand-footer__meta-link"
                         rel="noopener noreferrer"
                         aria-label="GitHub">GitHub</MudLink>
            </MudText>
        </div>

    </MudContainer>
</footer>

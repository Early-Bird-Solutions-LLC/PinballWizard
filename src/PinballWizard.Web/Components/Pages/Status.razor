@* Status — system health page.
 *
 * Public, anonymous-accessible page showing the current health of the three
 * Azure backing services: Cosmos DB, Azure AI Foundry, and AI Search.
 *
 * Render semantics:
 *   SSR / static render  → all three cards show "Unknown" (amber) state.
 *   InteractiveServer    → OnInitializedAsync calls IWizardLandingClient to
 *                          fetch /api/wizard/landing and populate cards from
 *                          the embedded SystemStatus. Falls back gracefully
 *                          when the endpoint is unavailable.
 *
 * This mirrors the LiveStatusBadge semantics on the landing page
 * (ADR-0026 § Landing) but surfaces per-system detail in cards rather
 * than a single collapsed dot.
 *
 * Linked from BrandFooter ("Status" link — ADR-0027 § 1).
 *
 * ADR-0008  — MudBlazor strict (MudCard + MudText)
 * ADR-0026  § Landing — SystemStatus is the authoritative source of truth.
 *@

@page "/status"
@rendermode InteractiveServer
@attribute [AllowAnonymous]

@using Microsoft.AspNetCore.Authorization
@using PinballWizard.Application.Landing
@using PinballWizard.Web.Clients

@inject IWizardLandingClient LandingClient

<PageTitle>PinballWizard — System Status</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="status-page" data-testid="status-page">

    @* ── Page header ──────────────────────────────────────────────────────── *@
    <AppPageHeader Title="System Status"
                   Subtitle="Live health of the Azure backing services powering PinballWizard." />

    @* ── Status cards grid ────────────────────────────────────────────────── *@
    <MudGrid Spacing="3" Class="status-cards-grid" data-testid="status-cards-grid">

        @* Cosmos DB *@
        <MudItem xs="12" sm="4">
            <MudCard Elevation="1" Class="status-card" data-testid="status-card-cosmos">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Cosmos DB</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"
                              data-testid="status-indicator-cosmos">
                        <MudIcon Icon="@Icons.Material.Filled.Storage"
                                 Size="Size.Small"
                                 Color="Color.Secondary" />
                        @if (_isLoading)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="20px" />
                        }
                        else
                        {
                            <span class="@DotClass(_status?.CosmosHealthy)"
                                  aria-hidden="true"></span>
                            <MudText Typo="Typo.body2">Cosmos DB — @StatusLabel(_status?.CosmosHealthy)</MudText>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Azure AI Foundry *@
        <MudItem xs="12" sm="4">
            <MudCard Elevation="1" Class="status-card" data-testid="status-card-foundry">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Azure AI Foundry</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"
                              data-testid="status-indicator-foundry">
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy"
                                 Size="Size.Small"
                                 Color="Color.Secondary" />
                        @if (_isLoading)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="20px" />
                        }
                        else
                        {
                            <span class="@DotClass(_status?.FoundryHealthy)"
                                  aria-hidden="true"></span>
                            <MudText Typo="Typo.body2">Azure AI Foundry — @StatusLabel(_status?.FoundryHealthy)</MudText>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* AI Search *@
        <MudItem xs="12" sm="4">
            <MudCard Elevation="1" Class="status-card" data-testid="status-card-search">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">AI Search</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"
                              data-testid="status-indicator-search">
                        <MudIcon Icon="@Icons.Material.Filled.Search"
                                 Size="Size.Small"
                                 Color="Color.Secondary" />
                        @if (_isLoading)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="20px" />
                        }
                        else
                        {
                            <span class="@DotClass(_status?.AiSearchHealthy)"
                                  aria-hidden="true"></span>
                            <MudText Typo="Typo.body2">AI Search — @StatusLabel(_status?.AiSearchHealthy)</MudText>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

    </MudGrid>

    @* ── Footer note ──────────────────────────────────────────────────────── *@
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-6 mb-8 status-note"
             data-testid="status-note">
        Status is refreshed each time this page loads.
        "Unknown" means the status endpoint is unavailable — the Wizard may still be operational.
    </MudText>

</MudContainer>

@code {
    // Null until the API call completes or falls back.
    // null → "Unknown" (amber) on all cards — the probe is in flight or the endpoint is down.
    private SystemStatus? _status;

    // True on first render — cards show MudSkeleton until OnInitializedAsync completes.
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var landing = await LandingClient
                .GetLandingAsync(CancellationToken.None)
                .ConfigureAwait(false);

            // Pull SystemStatus from the landing payload; leave null if the
            // endpoint is unavailable — cards render "Unknown" (amber) gracefully.
            _status = landing?.SystemStatus;
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────

    private static string DotClass(bool? healthy) =>
        healthy switch
        {
            true  => "status-dot status-dot--green",
            false => "status-dot status-dot--red",
            null  => "status-dot status-dot--amber",
        };

    private static string StatusLabel(bool? healthy) =>
        healthy switch
        {
            true  => "Healthy",
            false => "Degraded",
            null  => "Unknown",
        };
}

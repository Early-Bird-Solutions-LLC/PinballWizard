@page "/admin/machines/{OpdbId}"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using PinballWizard.Application.Catalog
@using PinballWizard.Application.Persistence
@using PinballWizard.Core.Domain
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inherits AdminPageBase

@* AdminMachineDetail — /admin/machines/{opdbId} per-game diagnostic view.
 *
 * Refactored to wrap the shared MachineDetail component.
 *@

@inject NavigationManager Nav

<PageTitle>@(OpdbId) — PinballWizard Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-4" />

    @if (string.IsNullOrWhiteSpace(Mfr))
    {
        <MudAlert Severity="Severity.Info" Class="mb-4" data-testid="detail-missing-mfr">
            Manufacturer is required to load machine details. Navigate here from the
            <MudLink Href="/admin/machines">Machine Catalog</MudLink> — it always
            supplies the <code>?mfr=</code> query parameter.
        </MudAlert>
    }
    else
    {
        <PinballWizard.Web.Components.Shared.MachineDetail OpdbId="@OpdbId" 
                                                          ManufacturerKey="@Mfr" 
                                                          IsAdmin="true" />
    }
</MudContainer>

@code {
    [Parameter] public string OpdbId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "mfr")]
    public string? Mfr { get; set; }

    private List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Admin",    href: "/admin",          icon: Icons.Material.Filled.Dashboard),
        new BreadcrumbItem("Machines", href: "/admin/machines", icon: Icons.Material.Filled.SportsBaseball),
    ];
}

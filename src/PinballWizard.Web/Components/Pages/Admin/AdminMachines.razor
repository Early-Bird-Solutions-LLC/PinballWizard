@page "/admin/machines"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using PinballWizard.Application.Catalog
@using PinballWizard.Application.Persistence
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inherits AdminPageBase

@* AdminMachines — /admin/machines flat machine catalog (AB#259).
 *
 * Loads all manufacturer rollup docs via ICatalogStatsReadRepository.StreamAllManufacturersAsync
 * (bounded ~8-9 point reads, ADR-0036 compliant). Flattens to per-machine rows;
 * computes CatalogHealth.Evaluate per row.
 *
 * Interactive page (@rendermode InteractiveServer) per the ADR-0034 amendment
 * (2026-06-17) — the sortable/filterable grid is the showcase data surface;
 * AdminLayout providers are pinned interactive to match.
 *
 * Health column = MudChip (Color.Error / Color.Warning / Color.Success) — no row
 * background tinting per the design-review accessibility/contrast decision.
 *
 * ADR-0008  — MudBlazor strict
 * ADR-0009  — Entra External ID auth
 * ADR-0026  § 1 — routing inventory (/admin/machines)
 * ADR-0034  — admin per-need render mode (this page is interactive)
 * ADR-0036  — Cosmos read-access standard (Tier-1 reads only)
 *@

@inject ICatalogStatsReadRepository Stats
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject ILogger<AdminMachines> Logger

<PageTitle>Machine Catalog — PinballWizard Admin</PageTitle>

<AppPageShell Title="Machine Catalog"
              Subtitle="All pinball machines indexed across manufacturers and OPDB."
              Breadcrumbs="@_breadcrumbs">

    @if (_asOf is not null)
    {
        <MudText Typo="Typo.caption"
                 Color="Color.Tertiary"
                 Class="mb-4"
                 data-testid="catalog-as-of">
            Catalog as of @_asOf.Value.ToString("u") (UTC)
        </MudText>
    }

    @if (ManufacturerFilter is { Length: > 0 })
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" data-testid="machines-manufacturer-filter">
            <MudText Typo="Typo.body2">
                Showing machines for <strong>@FilterDisplayName</strong>
            </MudText>
            <MudLink Href="/admin/machines" Typo="Typo.body2">Clear filter</MudLink>
        </MudStack>
    }

    @if (_loading)
    {
        <AdminLoadingBar Label="Loading machine catalog" />
    }

    @if (_loadFailed)
    {
        <AppErrorAlert data-testid="catalog-load-failed">
            The machine catalog could not be loaded. Please refresh the page or check Cosmos
            connectivity. If the problem persists, verify the catalog stats container is
            populated by running <code>--build-catalog</code>.
        </AppErrorAlert>
    }

    <CatalogHealthLegend />

    <AppDataGrid T="MachineCatalogRow"
                 Items="@FilteredMachines"
                 SearchContext="admin-machines"
                 RowClick="@(EventCallback.Factory.Create<DataGridRowClickEventArgs<MachineCatalogRow>>(this, OnRowClick))"
                 data-testid="admin-machines-grid">

        <Columns>
            <PropertyColumn Property="x => x.Manufacturer" Title="Manufacturer">
                <CellTemplate>
                    @if (context.Item.ManufacturerDisplayName is not null)
                    {
                        <ManufacturerLink ManufacturerKey="@context.Item.Manufacturer"
                                          DisplayName="@(context.Item.ManufacturerDisplayName!)" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@context.Item.Manufacturer</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.HealthLabel" Title="Health">
                <CellTemplate>
                    @foreach (var flag in context.Item.HealthFlags)
                    {
                        <MudTooltip Text="@CatalogHealthColors.Describe(flag)">
                            <AppStatusChip Color="@HealthFlagColor(flag)"
                                           Class="mr-1">
                                @flag.ToString()
                            </AppStatusChip>
                        </MudTooltip>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.YearLabel" Title="Year" HeaderClass="text-right" CellClass="text-right" />
            <PropertyColumn Property="x => x.Source" Title="Source">
                <CellTemplate>
                    @if (context.Item.IsOpdbOnly)
                    {
                        <MudText Typo="Typo.body2">@context.Item.Source</MudText>
                    }
                    else
                    {
                        <MudLink Href="@($"/admin/sources/{Uri.EscapeDataString(context.Item.Source)}")"
                                 Typo="Typo.body2">@context.Item.Source</MudLink>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Title" Title="Title" />
            <PropertyColumn Property="x => x.Edition" Title="Edition" />
            <PropertyColumn Property="x => x.DocCount" Title="Docs" Sortable="true" HeaderClass="text-right" CellClass="text-right" Format="N0" />

        </Columns>
        <NoRecordsContent>
            @if (!_loadFailed)
            {
                <AppEmptyState Heading="No machines in catalog"
                               data-testid="admin-machines-empty">
                    <DetailContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Run <code>--source opdb</code> then <code>--build-catalog</code> to populate.
                        </MudText>
                    </DetailContent>
                </AppEmptyState>
            }
        </NoRecordsContent>

    </AppDataGrid>
</AppPageShell>

@code {
    // ── Query parameters ───────────────────────────────────────────────────────

    // When set, restricts the displayed rows to a single manufacturer partition
    // key (e.g. "stern"). Supplied by the /admin/manufacturers page "Machines"
    // link. Case-insensitive; empty string is treated as no filter.
    [SupplyParameterFromQuery(Name = "manufacturer")]
    public string? ManufacturerFilter { get; set; }

    // ── Row model ──────────────────────────────────────────────────────────────
    private sealed record MachineCatalogRow(
        string MachineId,
        string Manufacturer,
        string? ManufacturerDisplayName,
        string Title,
        string Edition,
        string YearLabel,       // "2024" or "Unknown" — display + sort key
        int    DocCount,
        string HealthLabel,     // dominant flag as short string (Health sort key)
        string Source,          // "OPDB only" | manufacturer key
        bool   IsOpdbOnly,      // true → plain text; false → link to /admin/sources/{Source}
        IReadOnlyList<CatalogHealthFlag> HealthFlags);

    // ── State ──────────────────────────────────────────────────────────────────
    private List<MachineCatalogRow> _machines = [];
    private bool _loading = true;
    private bool _loadFailed;
    private DateTimeOffset? _asOf;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Admin", href: "/admin", icon: Icons.Material.Filled.Dashboard),
        new BreadcrumbItem("Machines", href: "/admin/machines", icon: Icons.Material.Filled.SportsBaseball),
    ];

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    // Use OnAfterRenderAsync so the page shell (with the loading spinner) is sent
    // to the client immediately on first render rather than blocking the pre-render
    // pass until Cosmos data returns. The spinner is visible within ~100 ms of
    // navigation; data populates when the query completes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync().ConfigureAwait(true);
    }

    private async Task LoadAsync()
    {
        using var cts = CreateLoadCts(TimeSpan.FromSeconds(30));
        try
        {
            var rows = new List<MachineCatalogRow>();
            DateTimeOffset? minAsOf = null;

            await foreach (var mfr in Stats.StreamAllManufacturersAsync(cts.Token))
            {
                if (minAsOf is null || mfr.AsOfUtc < minAsOf)
                    minAsOf = mfr.AsOfUtc;

                foreach (var machine in mfr.Machines)
                {
                    // Siblings = same GroupId within the same manufacturer.
                    var siblings = machine.GroupId is not null
                        ? mfr.Machines
                              .Where(m => m.MachineId != machine.MachineId
                                       && m.GroupId   == machine.GroupId)
                              .ToList()
                        : (IReadOnlyList<MachineDocStats>)[];

                    var flags = CatalogHealth.Evaluate(machine, siblings);

                    rows.Add(new MachineCatalogRow(
                        MachineId:   machine.MachineId,
                        Manufacturer: mfr.Manufacturer,
                        ManufacturerDisplayName: mfr.ManufacturerDisplayName,
                        Title:       machine.Title,
                        Edition:     machine.EditionLabel ?? string.Empty,
                        YearLabel:   machine.Year?.ToString() ?? "Unknown",
                        DocCount:    machine.DocCount,
                        HealthLabel: HealthLabel(flags),
                        Source:      machine.IsOpdbOnly ? "OPDB only" : mfr.Manufacturer,
                        IsOpdbOnly:  machine.IsOpdbOnly,
                        HealthFlags: flags));
                }
            }

            _machines = rows;
            _asOf     = minAsOf;
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("Admin machine catalog load timed out after 30 s.");
            Snackbar.Add("Catalog load timed out — please refresh.", Severity.Warning);
            _loadFailed = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load admin machine catalog.");
            Snackbar.Add($"Failed to load catalog: {ex.Message}", Severity.Error);
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
            SafeStateHasChanged();
        }
    }

    // ── Event handlers ─────────────────────────────────────────────────────────
    private void OnRowClick(DataGridRowClickEventArgs<MachineCatalogRow> args)
    {
        var row = args.Item;
        Nav.NavigateTo($"/admin/machines/{row.MachineId}?mfr={Uri.EscapeDataString(row.Manufacturer)}");
    }

    // ── Filter helpers ─────────────────────────────────────────────────────────

    // Applies the ManufacturerFilter query parameter (if any) to the full row list.
    // Returns all rows when no filter is active (empty / null).
    private IEnumerable<MachineCatalogRow> FilteredMachines =>
        string.IsNullOrEmpty(ManufacturerFilter)
            ? _machines
            : _machines.Where(m => m.Manufacturer.Equals(ManufacturerFilter, StringComparison.OrdinalIgnoreCase));

    // Human-readable label for the active filter indicator: uses the ManufacturerDisplayName
    // from the first matching row when available; falls back to the raw key.
    private string FilterDisplayName =>
        string.IsNullOrEmpty(ManufacturerFilter)
            ? string.Empty
            : _machines
                  .FirstOrDefault(m => m.Manufacturer.Equals(ManufacturerFilter, StringComparison.OrdinalIgnoreCase))
                  ?.ManufacturerDisplayName ?? ManufacturerFilter;

    // ── Helpers ────────────────────────────────────────────────────────────────

    // Short string for the dominant health flag — backs the Health column's sort
    // key (the cell itself renders the full set of flag chips).
    private static string HealthLabel(IReadOnlyList<CatalogHealthFlag> flags) =>
        flags.Count == 0 || (flags.Count == 1 && flags[0] == CatalogHealthFlag.Ok)
            ? "OK"
            : flags[0] switch
            {
                CatalogHealthFlag.Empty      => "Empty",
                CatalogHealthFlag.NoManual   => "No manual",
                CatalogHealthFlag.EditionGap => "Edition gap",
                _                            => "OK",
            };

    // Map health flags to MudBlazor Color tokens — delegated to the shared helper
    // so a new flag only requires one update in CatalogHealthColors (ADR-0008 / FE-08).
    private static Color HealthFlagColor(CatalogHealthFlag flag) =>
        CatalogHealthColors.ForFlag(flag);
}

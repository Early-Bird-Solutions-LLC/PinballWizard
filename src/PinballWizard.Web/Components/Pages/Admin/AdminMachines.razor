@page "/admin/machines"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "AdminOnly")]

@* AdminMachines — /admin/machines machine catalog list (PR-Q2 Wave 3 skeleton).
 *
 * Renders a MudDataGrid of pinball machines from the catalog. No real data
 * transport yet — the grid binds to an empty list with an empty-state message.
 * A follow-up PR will wire the IMachineRepository query here.
 *
 * MachineCatalogRow is a nested record representing a catalog entry.
 * Columns: Title, Manufacturer, Year, Source.
 *
 * Category: admin surface — uses AdminLayout. MudDataGrid per ADR-0008.
 *
 * Auth: protected by the global FallbackPolicy — see AdminDashboard.razor.
 *
 * ADR-0008  — MudBlazor strict
 * ADR-0009  — Entra External ID auth
 * ADR-0026  § 1 — routing inventory (/admin/machines)
 *@

<PageTitle>Machine Catalog — PinballWizard Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-4" />

    <MudText Typo="Typo.h4" GutterBottom="true">Machine Catalog</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
        All pinball machines indexed across manufacturers and OPDB.
    </MudText>

    <MudDataGrid T="MachineCatalogRow"
                 Items="@_machines"
                 Hover="true"
                 Striped="true"
                 Dense="true"
                 Elevation="2"
                 data-testid="admin-machines-grid">

        <Columns>
            <PropertyColumn Property="x => x.Title" Title="Title" />
            <PropertyColumn Property="x => x.Manufacturer" Title="Manufacturer" />
            <PropertyColumn Property="x => x.Year" Title="Year" />
            <PropertyColumn Property="x => x.Source" Title="Source" />
        </Columns>

        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Class="py-8" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.Inbox"
                         Size="Size.Large"
                         Color="Color.Tertiary" />
                <MudText Typo="Typo.body1" data-testid="admin-machines-empty">
                    No machines in catalog
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Run <code>--source opdb</code> then <code>--build-catalog</code> to populate.
                </MudText>
            </MudStack>
        </NoRecordsContent>

    </MudDataGrid>
</MudContainer>

@code {
    // Placeholder row type — mirrors the machines Cosmos container shape.
    // No deps on Infrastructure; real transport arrives in a follow-up PR.
    private sealed record MachineCatalogRow(
        string Title,
        string Manufacturer,
        string Year,
        string Source);

    // Empty list — grid renders the empty state.
    private readonly IEnumerable<MachineCatalogRow> _machines = [];

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Admin", href: "/admin", icon: Icons.Material.Filled.Dashboard),
        new BreadcrumbItem("Machines", href: "/admin/machines", icon: Icons.Material.Filled.SportsBaseball),
    ];
}

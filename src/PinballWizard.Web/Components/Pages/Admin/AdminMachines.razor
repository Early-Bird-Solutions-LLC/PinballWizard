@page "/admin/machines"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using PinballWizard.Application.Catalog
@using PinballWizard.Application.Persistence
@attribute [Authorize(Policy = "AdminOnly")]

@* AdminMachines — /admin/machines manufacturer-grouped machine catalog (AB#259).
 *
 * Loads all manufacturer rollup docs via ICatalogStatsReadRepository.StreamAllManufacturersAsync
 * (bounded ~8-9 point reads, ADR-0036 compliant). Flattens to per-machine rows;
 * computes CatalogHealth.Evaluate per row.
 *
 * Group-by axis is driven by the ?groupBy= query parameter (default: manufacturer).
 * Recognized axes: manufacturer, health, franchise, year, source.
 * The axis selector renders as plain navigation links (href="/admin/machines?groupBy=..."),
 * each producing a full server-side re-render — no circuit required (ADR-0034).
 * MudDataGrid receives the active axis column with Grouping="true" at server-render
 * time; all other groupable columns have Grouping="false".
 *
 * Static page (no @rendermode) per ADR-0034 — AdminLayout providers are static.
 *
 * Health column = MudChip (Color.Error / Color.Warning / Color.Success) — no row
 * background tinting per the design-review accessibility/contrast decision.
 *
 * ADR-0008  — MudBlazor strict
 * ADR-0009  — Entra External ID auth
 * ADR-0026  § 1 — routing inventory (/admin/machines)
 * ADR-0034  — admin pages are static (no @rendermode)
 * ADR-0036  — Cosmos read-access standard (Tier-1 reads only)
 *@

@inject ICatalogStatsReadRepository Stats
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject ILogger<AdminMachines> Logger

<PageTitle>Machine Catalog — PinballWizard Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-4" />

    <MudText Typo="Typo.h4" GutterBottom="true">Machine Catalog</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        All pinball machines indexed across manufacturers and OPDB.
    </MudText>

    @* ── Group-by axis selector ──────────────────────────────────────────────
     * Plain href navigation — each click is a full server-side re-render.
     * Active axis gets Color.Primary + Filled variant; others are outlined.
     * This is entirely static; no @rendermode / circuit required.
     *@
    <MudStack Row="true" Spacing="1" Class="mb-4" data-testid="groupby-selector">
        @foreach (var axis in _axes)
        {
            var isActive = _activeAxis == axis.Value;
            <MudButton Href="@($"/admin/machines?groupBy={axis.Key}")"
                       Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                       Color="@(isActive ? Color.Primary : Color.Default)"
                       Size="Size.Small">
                @axis.Label
            </MudButton>
        }
    </MudStack>

    @if (_asOf is not null)
    {
        <MudText Typo="Typo.caption"
                 Color="Color.Tertiary"
                 Class="mb-4"
                 data-testid="catalog-as-of">
            Catalog as of @_asOf.Value.ToString("u") (UTC)
        </MudText>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    }

    <MudDataGrid T="MachineCatalogRow"
                 Items="@_machines"
                 Hover="true"
                 Striped="true"
                 Dense="true"
                 Elevation="2"
                 Groupable="true"
                 GroupExpanded="true"
                 RowClick="@OnRowClick"
                 data-testid="admin-machines-grid">

        <Columns>
            @* Each groupable column has Grouping="true" only when it is the active
             * axis. Exactly one column is active per render, determined server-side
             * from the query param. *@
            <PropertyColumn Property="x => x.Manufacturer"
                            Title="Manufacturer"
                            Groupable="true"
                            Grouping="@(_activeAxis == GroupByAxis.Manufacturer)" />
            <PropertyColumn Property="x => x.HealthLabel"
                            Title="Health Group"
                            Groupable="true"
                            Grouping="@(_activeAxis == GroupByAxis.Health)"
                            Hidden="@(_activeAxis != GroupByAxis.Health)" />
            <PropertyColumn Property="x => x.Franchise"
                            Title="Franchise"
                            Groupable="true"
                            Grouping="@(_activeAxis == GroupByAxis.Franchise)"
                            Hidden="@(_activeAxis != GroupByAxis.Franchise)" />
            <PropertyColumn Property="x => x.YearLabel"
                            Title="Year"
                            Groupable="true"
                            Grouping="@(_activeAxis == GroupByAxis.Year)"
                            Sortable="true" />
            <PropertyColumn Property="x => x.Source"
                            Title="Source"
                            Groupable="true"
                            Grouping="@(_activeAxis == GroupByAxis.Source)"
                            Hidden="@(_activeAxis != GroupByAxis.Source)" />
            <PropertyColumn Property="x => x.Title" Title="Title" />
            <PropertyColumn Property="x => x.Edition" Title="Edition" />
            <PropertyColumn Property="x => x.DocCount" Title="Docs" Sortable="true" />
            <TemplateColumn Title="Health">
                <CellTemplate>
                    @foreach (var flag in context.Item.HealthFlags)
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@HealthFlagColor(flag)"
                                 Variant="Variant.Filled"
                                 Class="mr-1">
                            @flag.ToString()
                        </MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>

        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Class="py-8" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.Inbox"
                         Size="Size.Large"
                         Color="Color.Tertiary" />
                <MudText Typo="Typo.body1" data-testid="admin-machines-empty">
                    No machines in catalog
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Run <code>--source opdb</code> then <code>--build-catalog</code> to populate.
                </MudText>
            </MudStack>
        </NoRecordsContent>

    </MudDataGrid>
</MudContainer>

@code {
    // ── Axis enum + registry ───────────────────────────────────────────────────

    private enum GroupByAxis { Manufacturer, Health, Franchise, Year, Source }

    private sealed record AxisDef(string Key, GroupByAxis Value, string Label);

    private static readonly AxisDef[] _axes =
    [
        new("manufacturer", GroupByAxis.Manufacturer, "Manufacturer"),
        new("health",        GroupByAxis.Health,       "Health"),
        new("franchise",     GroupByAxis.Franchise,    "Franchise"),
        new("year",          GroupByAxis.Year,         "Year"),
        new("source",        GroupByAxis.Source,       "Source"),
    ];

    // ── Query parameter ────────────────────────────────────────────────────────
    // Blazor populates this from the query string before OnInitializedAsync runs
    // on a static server render — no circuit required.
    [SupplyParameterFromQuery(Name = "groupBy")]
    public string? GroupBy { get; set; }

    // ── Row model ──────────────────────────────────────────────────────────────
    private sealed record MachineCatalogRow(
        string MachineId,
        string Manufacturer,
        string Title,
        string Edition,
        string YearLabel,       // string so it groups as "2024" not int bucket
        int    DocCount,
        string HealthLabel,     // dominant flag as short string for grouping
        string Franchise,       // GroupId or "(none)"
        string Source,          // "OPDB only" | manufacturer key
        IReadOnlyList<CatalogHealthFlag> HealthFlags);

    // ── State ──────────────────────────────────────────────────────────────────
    private List<MachineCatalogRow> _machines = [];
    private bool _loading = true;
    private DateTimeOffset? _asOf;
    private GroupByAxis _activeAxis = GroupByAxis.Manufacturer;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Admin", href: "/admin", icon: Icons.Material.Filled.Dashboard),
        new BreadcrumbItem("Machines", href: "/admin/machines", icon: Icons.Material.Filled.SportsBaseball),
    ];

    // ── Lifecycle ──────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // Resolve the active axis from the query param — available at this point
        // on a static server render because Blazor sets [SupplyParameterFromQuery]
        // properties before calling OnInitializedAsync.
        _activeAxis = _axes.FirstOrDefault(a => string.Equals(a.Key, GroupBy, StringComparison.OrdinalIgnoreCase))?.Value
                      ?? GroupByAxis.Manufacturer;

        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        try
        {
            var rows = new List<MachineCatalogRow>();
            DateTimeOffset? minAsOf = null;

            await foreach (var mfr in Stats.StreamAllManufacturersAsync(cts.Token))
            {
                if (minAsOf is null || mfr.AsOfUtc < minAsOf)
                    minAsOf = mfr.AsOfUtc;

                foreach (var machine in mfr.Machines)
                {
                    // Siblings = same GroupId within the same manufacturer.
                    var siblings = machine.GroupId is not null
                        ? mfr.Machines
                              .Where(m => m.MachineId != machine.MachineId
                                       && m.GroupId   == machine.GroupId)
                              .ToList()
                        : (IReadOnlyList<MachineDocStats>)[];

                    var flags = CatalogHealth.Evaluate(machine, siblings);

                    rows.Add(new MachineCatalogRow(
                        MachineId:   machine.MachineId,
                        Manufacturer: mfr.Manufacturer,
                        Title:       machine.Title,
                        Edition:     machine.EditionLabel ?? string.Empty,
                        YearLabel:   machine.Year?.ToString() ?? "Unknown",
                        DocCount:    machine.DocCount,
                        HealthLabel: HealthLabel(flags),
                        Franchise:   machine.GroupId ?? "(none)",
                        Source:      machine.IsOpdbOnly ? "OPDB only" : mfr.Manufacturer,
                        HealthFlags: flags));
                }
            }

            _machines = rows;
            _asOf     = minAsOf;
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("Admin machine catalog load timed out after 30 s.");
            Snackbar.Add("Catalog load timed out — please refresh.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load admin machine catalog.");
            Snackbar.Add($"Failed to load catalog: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Event handlers ─────────────────────────────────────────────────────────
    private void OnRowClick(DataGridRowClickEventArgs<MachineCatalogRow> args)
    {
        var row = args.Item;
        Nav.NavigateTo($"/admin/machines/{row.MachineId}?mfr={Uri.EscapeDataString(row.Manufacturer)}");
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    // Short string for the dominant health flag — used as the group label when
    // grouping by health axis.
    private static string HealthLabel(IReadOnlyList<CatalogHealthFlag> flags) =>
        flags.Count == 0 || (flags.Count == 1 && flags[0] == CatalogHealthFlag.Ok)
            ? "OK"
            : flags[0] switch
            {
                CatalogHealthFlag.Empty      => "Empty",
                CatalogHealthFlag.NoManual   => "No manual",
                CatalogHealthFlag.EditionGap => "Edition gap",
                _                            => "OK",
            };

    // Map health flags to MudBlazor Color tokens — no hex values (ADR-0008 / FE-08).
    private static Color HealthFlagColor(CatalogHealthFlag flag) => flag switch
    {
        CatalogHealthFlag.Empty      => Color.Error,
        CatalogHealthFlag.NoManual   => Color.Warning,
        CatalogHealthFlag.EditionGap => Color.Warning,
        CatalogHealthFlag.Ok         => Color.Success,
        _                            => Color.Default,
    };
}

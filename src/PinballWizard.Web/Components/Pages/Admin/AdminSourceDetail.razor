@page "/admin/sources/{Id}"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PinballWizard.Application.Catalog
@using PinballWizard.Application.Persistence
@using Microsoft.Extensions.Options
@using PinballWizard.Core.Configuration
@using PinballWizard.Core.Domain
@using PinballWizard.Core.Models
@using PinballWizard.Web.Security
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inherits AdminPageBase
@inject IOptions<PolitenessOptions> PolitenessOpts
@inject IIngestionSourceRepository SourceRepo
@inject ICatalogStatsReadRepository CatalogStatsRepo
@inject IScrapeRunRepository ScrapeRunRepo
@inject AdminActionGuard Guard
@inject ISnackbar Snackbar
@inject ILogger<AdminSourceDetail> Logger

@* AdminSourceDetail — /admin/sources/{id} single-source drill-down + gated enable/disable.
 *
 * Interactive (@rendermode InteractiveServer, ADR-0034 amendment): public-read content
 * for everyone; the Enabled/Disabled control is a read-only chip for anonymous visitors
 * and a MudSwitch for admins. The toggle is gated by AdminActionGuard at the top of the
 * handler (UI hiding the switch is not the boundary, the #477 doctrine). Two single-
 * partition point-reads (ADR-0036) in OnAfterRenderAsync (loads once on the client, avoids
 * the prerender double-read); the catalog read is section-isolated. Failures degrade
 * visibly: load failures via MudAlert, the toggle via ISnackbar with the switch reverting
 * to the persisted state (Invariant #17 — never a fabricated success).
 *
 * ADR-0007  — IngestionSource is runtime Cosmos config
 * ADR-0008  — MudBlazor strict
 * ADR-0034  — render-mode doctrine (interactive admin pages)
 * ADR-0036  — Cosmos read-access (single-partition point-reads)
 * ADR-0046  — shared Blazor component library (AppPageShell)
 *@

<PageTitle>Source Detail — PinballWizard Admin</PageTitle>

@inject IUserPreferencesService Prefs

<AppPageShell AccessibleTitle="Source detail" ChildProvidesHeading="@(_source is not null)">

    @if (_loading)
    {
        <AdminLoadingBar Label="Loading source detail" />
    }
    else if (_loadFailed)
    {
        <AppErrorAlert data-testid="source-detail-load-failed">
            This source could not be loaded. Please refresh the page or check Cosmos connectivity.
        </AppErrorAlert>
    }
    else if (_source is null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" data-testid="source-not-found">
            No ingestion source exists with id <code>@Id</code>.
            <MudLink Href="/admin/sources">Back to all sources</MudLink>
        </MudAlert>
    }
    else
    {
        <AppPageHeader Title="@_source.DisplayName"
                       Breadcrumbs="@Breadcrumbs" />

        @* a. Source config + run stats *@
        <MudPaper Class="pa-4 mb-4 pw-readable" Elevation="2" data-testid="source-config">
            <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">Configuration &amp; run stats</MudText>
            <MudStack Spacing="1">
                @KeyValue("Scraper key", _source.ScraperImplKey)
                <MudStack Row="true" Spacing="2" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Base URL</MudText>
                    <MudLink Href="@_source.BaseUrl" Target="_blank" rel="noopener">@_source.BaseUrl</MudLink>
                </MudStack>
                <MudStack Row="true" Spacing="2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Status</MudText>
                    @if (_isAdmin)
                    {
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            @if (_toggleBusy)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                                     data-testid="source-enabled-busy" />
                            }
                            @* @key forces MudSwitch to reinitialize from Value when a
                             * failed toggle must revert: Blazor's diff skips SetParametersAsync
                             * on the child when Value is unchanged from the parent's perspective,
                             * keeping MudBlazor's ParameterState at the user-changed value.
                             * Incrementing _switchResetToken on revert breaks the diff identity
                             * and lets the fresh component read Value=_source.Enabled correctly. *@
                            <MudSwitch @key="_switchResetToken"
                                       T="bool"
                                       Value="_source.Enabled"
                                       ValueChanged="ToggleEnabledAsync"
                                       Color="Color.Success"
                                       Disabled="_toggleBusy"
                                       Label="@($"Scraping for {_source.DisplayName}")"
                                       data-testid="source-enabled-switch" />
                        </MudStack>
                    }
                    else
                    {
                        <AppStatusChip Color="@(_source.Enabled ? Color.Success : Color.Default)"
                                       data-testid="source-enabled-chip">
                            @(_source.Enabled ? "Enabled" : "Disabled")
                        </AppStatusChip>
                    }
                </MudStack>
                @KeyValue("Cadence", _source.Cadence)
                @KeyValue("Last run", _source.LastRunAt?.ToString("u") ?? "—")
                @KeyValue("Last success", _source.LastSuccessAt?.ToString("u") ?? "—")
                @KeyValue("Documents discovered", _source.TotalDocumentsDiscovered.ToString())
                @KeyValue("Run failures", _source.TotalRunFailures.ToString())
            </MudStack>
        </MudPaper>

        @* b. Politeness overrides — the polite-by-construction showcase surface.
         * A null field (or a null PolitenessOverrides) means the global default
         * applies; that is shown explicitly, not as a blank. *@
        <MudPaper Class="pa-4 mb-4 pw-readable" Elevation="2" data-testid="source-politeness">
            <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">Politeness overrides</MudText>
            <MudStack Spacing="1">
                @{ var p = _source.PolitenessOverrides; var po = PolitenessOpts.Value; }
                @KeyValue("Request delay (ms)", p?.RequestDelayMs?.ToString() ?? $"{po.RequestDelayMs} (default)")
                @KeyValue("robots.txt path",    p?.RobotsTxtPath               ?? $"{po.RobotsTxtPath} (default)")
                @KeyValue("User-Agent suffix",  p?.UserAgentSuffix             ?? "none (default)")
                @KeyValue("Max 429 streak",     p?.Max429Streak?.ToString()    ?? $"{po.Max429Streak} (default)")
            </MudStack>
        </MudPaper>

        @* c. Catalog contribution — null stats = not a manufacturer catalog
         * source (n/a); a thrown read is a section-scoped error (Invariant #17). *@
        <MudPaper Class="pa-4 mb-4 pw-readable" Elevation="2" data-testid="source-catalog">
            <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">Catalog contribution</MudText>
            @if (_catalogFailed)
            {
                <AppErrorAlert data-testid="catalog-load-failed">
                    Catalog contribution could not be loaded.
                </AppErrorAlert>
            }
            else if (_stats is null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="catalog-na">
                    Not a manufacturer catalog source — n/a
                </MudText>
            }
            else
            {
                <MudStack Spacing="1">
                    @KeyValue("Machines", _stats.Machines.Count.ToString())
                    @KeyValue("Total documents", _stats.Machines.Sum(m => m.DocCount).ToString())
                    @KeyValue("Projection as of", _stats.AsOfUtc.ToString("u"))
                </MudStack>
            }
        </MudPaper>

        @* d. Run history — newest-first per-source scrape runs (feature #5a). Section-
         * isolated: a read failure shows a scoped alert; an empty set is the honest state
         * for sources not yet instrumented (every ISourceScraper source until 5b). *@
        <MudPaper Class="pa-4 mt-4" Elevation="2" data-testid="source-run-history">
            <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">Run history</MudText>
            @if (_runHistoryFailed)
            {
                <AppErrorAlert data-testid="run-history-failed">
                    Run history could not be loaded.
                </AppErrorAlert>
            }
            else if (_runs.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="run-history-empty">
                    No runs recorded yet.
                </MudText>
            }
            else
            {
                @* AppDataGrid not used: ChildRowContent requires typed RenderFragment<CellContext<T>> which cannot splat through AdditionalAttributes — ADR-0046 documented exception *@
                <MudDataGrid T="ScrapeRunRecord" Items="@_runs"
                             Dense="true" Hover="true" Striped="true" Elevation="2"
                             RowsPerPage="@Prefs.PageSize"
                             data-testid="run-history-table">
                    <Columns>
                        @* HeaderTemplate, not Title: HierarchyColumn rejects Title (MudBlazor
                           analyzer MUD0002). Without a header MudBlazor emits an empty <th>
                           for the expand-toggle column, which axe reports as
                           empty-table-header — a header cell naming nothing leaves screen
                           reader users no way to identify the column (#790). The label is
                           visually hidden because the column is a narrow icon toggle where a
                           visible caption would look wrong; pw-visually-hidden keeps it in
                           the accessibility tree, which is the whole point. *@
                        <HierarchyColumn T="ScrapeRunRecord">
                            <HeaderTemplate>
                                <span class="pw-visually-hidden">Expand run details</span>
                            </HeaderTemplate>
                        </HierarchyColumn>
                        <TemplateColumn Title="Run (UTC)" HeaderClass="text-right" CellClass="text-right">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@context.Item.RunAt.UtcDateTime.ToString("u")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <AppStatusChip Color="@(context.Item.Succeeded ? Color.Success : Color.Error)">
                                    @(context.Item.Succeeded ? "Success" : "Failed")
                                </AppStatusChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Duration" HeaderClass="text-right" CellClass="text-right">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@($"{context.Item.DurationSeconds:0.0} s")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Processed" HeaderClass="text-right" CellClass="text-right">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@context.Item.DocumentsDiscovered</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="New" HeaderClass="text-right" CellClass="text-right">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@context.Item.DocumentsNew</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Trigger">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(context.Item.Trigger ?? "manual")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Error">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(context.Item.ErrorMessage ?? "")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <ChildRowContent>
                        <AdminRunDocuments SourceId="@Id" RunId="@RunKey(context.Item)" />
                    </ChildRowContent>
                </MudDataGrid>
            }
        </MudPaper>
    }
</AppPageShell>

@code {
    [Parameter] public string Id { get; set; } = default!;

    // Ingestion-source documents share a single logical partition ("config");
    // see IngestionSource.PartitionKey. No shared constant is exported, so this
    // literal mirrors the repository's own ConfigPartition.
    private const string ConfigPartition = "config";

    private IngestionSource? _source;
    private ManufacturerCatalogStats? _stats;
    private bool _loading = true;
    private bool _loadFailed;     // source point-read failed/timed out
    private bool _catalogFailed;  // catalog point-read failed/timed out (section-scoped)
    private IReadOnlyList<ScrapeRunRecord> _runs = [];
    private bool _runHistoryFailed;  // run-history read failed (section-scoped)

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool _isAdmin;
    private bool _toggleBusy;
    private int _switchResetToken;  // incremented on revert to force MudSwitch @key change

    private List<BreadcrumbItem> Breadcrumbs =>
    [
        new BreadcrumbItem("Admin", href: "/admin", icon: Icons.Material.Filled.Dashboard),
        new BreadcrumbItem("Sources", href: "/admin/sources", icon: Icons.Material.Filled.Source),
        new BreadcrumbItem(_source?.DisplayName ?? Id, href: null, disabled: true),
    ];

    // Interactive: load once on the client (OnAfterRenderAsync firstRender) so the shell +
    // loading bar render instantly and the two Cosmos reads aren't run twice (prerender +
    // circuit). Matches AdminMachineDetail / AdminDocumentTriage.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var cts = CreateLoadCts(TimeSpan.FromSeconds(30));

        _isAdmin = await Guard.IsAdminAsync(AuthState);

        try
        {
            // Read 1 — source config (single-partition point read).
            try
            {
                _source = await SourceRepo.GetByIdAsync(Id, ConfigPartition, cts.Token);
            }
            catch (OperationCanceledException)
            {
                Logger.LogWarning("Admin source-detail load timed out after 30 s for id '{Id}'.", Id);
                _loadFailed = true;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load admin source '{Id}'.", Id);
                _loadFailed = true;
            }

            // Read 2 — catalog contribution, only when the source loaded. A null result is
            // a legitimate "non-manufacturer source"; a throw is a section-scoped failure
            // that must NOT blank the config/politeness sections from the first read.
            if (_source is not null)
            {
                try
                {
                    _stats = await CatalogStatsRepo.GetByManufacturerAsync(_source.ScraperImplKey, cts.Token);
                }
                catch (OperationCanceledException)
                {
                    Logger.LogWarning(
                        "Admin source-detail catalog read timed out for manufacturer '{Key}'.",
                        _source.ScraperImplKey);
                    _catalogFailed = true;
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to load catalog stats for manufacturer '{Key}'.",
                        _source.ScraperImplKey);
                    _catalogFailed = true;
                }

                // Read 3 — run history (newest 20, single-partition by source id). Section-
                // isolated: a failure here must NOT blank the config/politeness/catalog sections.
                try
                {
                    var runs = new List<ScrapeRunRecord>();
                    await foreach (var run in ScrapeRunRepo.StreamBySourceAsync(Id, 20, cts.Token))
                    {
                        runs.Add(run);
                    }
                    _runs = runs;
                }
                catch (OperationCanceledException)
                {
                    Logger.LogWarning("Admin source-detail run-history read timed out for source '{Id}'.", Id);
                    _runHistoryFailed = true;
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to load run history for source '{Id}'.", Id);
                    _runHistoryFailed = true;
                }
            }
        }
        finally
        {
            _loading = false;
            SafeStateHasChanged();
        }
    }

    // Gated mutation: server-side guard FIRST (UI hiding the switch is not the boundary).
    // On success, reflect the new state + snackbar; on a false return (source vanished) or a
    // throw, leave _source.Enabled unchanged so the switch reverts — never a fabricated
    // success (Invariant #17). ValueChanged (not @bind) so this handler owns the transition.
    private async Task ToggleEnabledAsync(bool newValue)
    {
        if (!await Guard.IsAdminAsync(AuthState))
        {
            Snackbar.Add("Sign in as an administrator to perform this action.", Severity.Warning);
            return;
        }
        if (_source is null) return;

        _toggleBusy = true;
        SafeStateHasChanged();
        using var cts = CreateLoadCts(TimeSpan.FromSeconds(30));
        try
        {
            var updated = await SourceRepo.SetEnabledAsync(_source.Id, newValue, cts.Token);
            if (updated)
            {
                _source.Enabled = newValue;
                Snackbar.Add(
                    $"{_source.DisplayName} scraping {(newValue ? "enabled" : "disabled")}.",
                    Severity.Success);
            }
            else
            {
                _switchResetToken++;  // revert: force MudSwitch @key change → fresh init from Value
                Snackbar.Add(
                    $"{_source.DisplayName} no longer exists — refresh the page.",
                    Severity.Warning);
            }
        }
        catch (OperationCanceledException)
        {
            _switchResetToken++;  // revert: force MudSwitch @key change → fresh init from Value
            Logger.LogWarning("Toggling source '{Id}' timed out.", _source.Id);
            Snackbar.Add("The change timed out — please try again.", Severity.Error);
        }
        catch (Exception ex)
        {
            _switchResetToken++;  // revert: force MudSwitch @key change → fresh init from Value
            Logger.LogError(ex, "Failed to toggle source '{Id}'.", _source.Id);
            Snackbar.Add($"Failed to update source: {ex.Message}", Severity.Error);
        }
        finally
        {
            _toggleBusy = false;
            SafeStateHasChanged();
        }
    }

    // Run key used as the RunId passed to AdminRunDocuments (the child row).
    private string RunKey(ScrapeRunRecord run) => ScrapeRunId.For(run.SourceId, run.RunAt);

    // Inline label/value row — kept DRY across the three sections.
    private RenderFragment KeyValue(string label, string value) =>@<MudStack Row="true" Spacing="2" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.body2" Color="Color.Secondary">@label</MudText>
        <MudText Typo="Typo.body2">@value</MudText>
    </MudStack>;
}

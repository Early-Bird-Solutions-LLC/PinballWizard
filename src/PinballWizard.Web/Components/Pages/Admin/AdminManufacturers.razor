@page "/admin/manufacturers"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using PinballWizard.Application.Persistence
@using PinballWizard.Core.Domain
@attribute [AllowAnonymous]
@rendermode InteractiveServer

@* AdminManufacturers — /admin/manufacturers catalog-by-brand overview.
 *
 * Interactive page (@rendermode InteractiveServer) — MudTableSortLabel requires a
 * live Blazor circuit. Data loads once in OnInitializedAsync.
 *
 * Two reads: (1) IMachineRepository.StreamAllAsync (cross-partition, already in the
 * ADR-0036 allow-list for MachineRepository.cs) — streams every machine and groups
 * by manufacturer partition key in memory, surfacing ALL manufacturers including
 * OPDB-only ones (Williams, Bally, Gottlieb, etc.) that have no scraper source.
 * (2) IIngestionSourceRepository.StreamAllAsync (single 'config' partition) —
 * best-effort enrichment for Enabled status. ManufacturerDisplayName comes from
 * the machine records, so rows never degrade to the raw key.
 *
 * Sorted alphabetically by default (no ranking — favoritism guardrail). User can
 * re-sort by Manufacturer, Status, or Machines via MudTableSortLabel. Paged via
 * MudTablePager (25 / 50 / 100 rows). Rows with an ingestion source link to the
 * source-detail page; OPDB-only rows render plain text. Failures degrade visibly
 * (Invariant #17): machine-load failure shows a MudAlert; empty set a distinct
 * empty state; source enrichment failure leaves Enabled = "—".
 *
 * ADR-0008  — MudBlazor strict
 * ADR-0034  — render-mode doctrine (interactive for sortable grid)
 * ADR-0036  — Cosmos read-access (cross-partition via StreamAllAsync, allow-listed)
 *@

@inject IMachineRepository MachineRepo
@inject IIngestionSourceRepository SourceRepo
@inject ILogger<AdminManufacturers> Logger

<PageTitle>Manufacturers — PinballWizard Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-4" />

    <MudText Typo="Typo.h4" GutterBottom="true">Manufacturers</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
        Catalog contribution per manufacturer — machines and catalog documents.
    </MudText>

    @if (_loading)
    {
        <AdminLoadingBar Label="Loading manufacturers" />
    }
    else if (_loadFailed)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="manufacturers-load-failed">
            Manufacturer stats could not be loaded. Please refresh the page or check Cosmos connectivity.
        </MudAlert>
    }
    else if (_rows.Count == 0)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-8" Spacing="2" data-testid="manufacturers-empty">
            <MudIcon Icon="@Icons.Material.Outlined.Inbox" Size="Size.Large" Color="Color.Tertiary" />
            <MudText Typo="Typo.body1">No manufacturers found</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                The machine catalog does not contain any machines yet.
            </MudText>
        </MudStack>
    }
    else
    {
        <MudTable T="ManufacturerRow" Items="_rows" Dense="true" Hover="true" Elevation="2"
                  data-testid="manufacturers-table">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel T="ManufacturerRow"
                                       InitialDirection="SortDirection.Ascending"
                                       SortBy="@(r => r.DisplayName)">
                        Manufacturer
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="ManufacturerRow"
                                       SortBy="@(r => (object)(r.Enabled switch { true => 0, false => 1, _ => 2 }))">
                        Status
                    </MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align:right">
                    <MudTableSortLabel T="ManufacturerRow" SortBy="@(r => (object)r.Machines)">
                        Machines
                    </MudTableSortLabel>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Manufacturer">
                    @if (context.HasSource)
                    {
                        <MudLink Href="@($"/admin/sources/{context.Key}")">@context.DisplayName</MudLink>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@context.DisplayName</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (context.Enabled is { } enabled)
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(enabled ? Color.Success : Color.Default)">
                            @(enabled ? "Enabled" : "Disabled")
                        </MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Machines" Style="text-align:right">@context.Machines</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[]{25, 50, 100}" />
            </PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private sealed record ManufacturerRow(
        string Key, string DisplayName, bool? Enabled, bool HasSource, int Machines);

    private List<ManufacturerRow> _rows = [];
    private bool _loading = true;
    private bool _loadFailed;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Admin", href: "/admin", icon: Icons.Material.Filled.Dashboard),
        new BreadcrumbItem("Manufacturers", href: "/admin/manufacturers", icon: Icons.Material.Filled.Factory),
    ];

    protected override async Task OnInitializedAsync()
    {
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));

        // Best-effort enrichment: key → (DisplayName, Enabled). Failure leaves Enabled = null ("—").
        var sourceLookup = new Dictionary<string, (string DisplayName, bool Enabled)>(StringComparer.OrdinalIgnoreCase);
        try
        {
            await foreach (var s in SourceRepo.StreamAllAsync(cts.Token))
                sourceLookup[s.Id] = (s.DisplayName, s.Enabled);
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("Admin manufacturers: ingestion-source enrichment read timed out; Enabled column degrades to '—'.");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Admin manufacturers: ingestion-source enrichment read failed; Enabled column degrades to '—'.");
        }

        // Core read: stream all machines and group by manufacturer partition key.
        // ManufacturerDisplayName from machine records — no raw-key degradation even
        // for OPDB-only manufacturers without a scraper source.
        try
        {
            var groups = new Dictionary<string, (string DisplayName, int Count)>(StringComparer.OrdinalIgnoreCase);
            await foreach (var machine in MachineRepo.StreamAllAsync(cts.Token))
            {
                if (!groups.TryGetValue(machine.PartitionKey, out var g))
                    groups[machine.PartitionKey] = (machine.ManufacturerDisplayName, 1);
                else
                    groups[machine.PartitionKey] = (g.DisplayName, g.Count + 1);
            }

            _rows = groups
                .Select(kvp =>
                {
                    var found = sourceLookup.TryGetValue(kvp.Key, out var src);
                    return new ManufacturerRow(
                        Key:         kvp.Key,
                        DisplayName: found ? src.DisplayName : kvp.Value.DisplayName,
                        Enabled:     found ? src.Enabled : null,
                        HasSource:   found,
                        Machines:    kvp.Value.Count);
                })
                .OrderBy(r => r.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("Admin manufacturers: machine catalog stream timed out after 30 s.");
            _loadFailed = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load manufacturers from machine catalog.");
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }
}

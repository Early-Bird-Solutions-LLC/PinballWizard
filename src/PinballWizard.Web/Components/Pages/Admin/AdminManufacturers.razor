@page "/admin/manufacturers"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using PinballWizard.Application.Catalog
@using PinballWizard.Application.Persistence
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inherits AdminPageBase

@* AdminManufacturers — /admin/manufacturers catalog-by-brand overview.
 *
 * Interactive page (@rendermode InteractiveServer) — MudDataGrid sorting requires a
 * live Blazor circuit. Data loads once in OnInitializedAsync.
 *
 * Core read: ICatalogStatsReadRepository.StreamAllManufacturersAsync (bounded ~8-9
 * point reads, ADR-0036 compliant). Each ManufacturerCatalogStats carries the full
 * machine list so Machines count and Documents (sum of DocCount) are computed in
 * memory without a cross-partition scan.
 *
 * Enabled-status enrichment via IIngestionSourceRepository.StreamAllAsync is preserved
 * exactly as before (best-effort, degrades to "—" on failure). ManufacturerDisplayName
 * comes from the rollup doc; rows never degrade to the raw key unless the rollup
 * predates the backfill.
 *
 * Manufacturer name cell links to the admin machines view filtered by this manufacturer
 * (/admin/machines?manufacturer={key}) so admins can drill down without a full scan.
 * Documents cell links to /admin/documents?manufacturer={key}.
 *
 * Sorted alphabetically by default (no ranking — favoritism guardrail). Failures
 * degrade visibly (Invariant #17): stats-load failure shows a MudAlert; source
 * enrichment failure leaves Enabled = "—" while Machines/Documents counts survive.
 *
 * ADR-0008  — MudBlazor strict
 * ADR-0034  — render-mode doctrine (interactive for sortable grid)
 * ADR-0036  — Cosmos read-access (Tier-1 bounded reads via StreamAllManufacturersAsync)
 *@

@inject ICatalogStatsReadRepository Stats
@inject IIngestionSourceRepository SourceRepo
@inject ILogger<AdminManufacturers> Logger

<PageTitle>Manufacturers — PinballWizard Admin</PageTitle>

<AppPageShell Title="Manufacturers"
              Subtitle="Catalog contribution per manufacturer — machines and catalog documents."
              Breadcrumbs="@_breadcrumbs">

    @if (_loading)
    {
        <AdminLoadingBar Label="Loading manufacturers" />
    }
    else if (_loadFailed)
    {
        <AppErrorAlert data-testid="manufacturers-load-failed">
            Manufacturer stats could not be loaded. Please refresh the page or check Cosmos connectivity.
        </AppErrorAlert>
    }
    else if (_rows.Count == 0)
    {
        <AppEmptyState Heading="No manufacturers found"
                       Detail="The machine catalog does not contain any machines yet."
                       data-testid="manufacturers-empty" />
    }
    else
    {
        <AppDataGrid T="ManufacturerRow" Items="@_rows" SearchContext="admin-manufacturers" data-testid="manufacturers-table">
            <Columns>
                <TemplateColumn Title="Manufacturer" Sortable="true"
                                SortBy="@(new Func<ManufacturerRow, object>(r => r.DisplayName))"
                                InitialDirection="SortDirection.Ascending">
                    <CellTemplate>
                        <MudLink Href="@($"/admin/machines?manufacturer={Uri.EscapeDataString(context.Item.Key)}")"
                                 Typo="Typo.body2">@context.Item.DisplayName</MudLink>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Status" Sortable="true"
                                SortBy="@(new Func<ManufacturerRow, object>(r => r.Enabled switch { true => 0, false => 1, _ => 2 }))">
                    <CellTemplate>
                        @if (context.Item.Enabled is { } enabled)
                        {
                            <AppStatusChip Color="@(enabled ? Color.Success : Color.Default)">
                                @(enabled ? "Enabled" : "Disabled")
                            </AppStatusChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Machines" Sortable="true" HeaderClass="text-right" CellClass="text-right"
                                SortBy="@(new Func<ManufacturerRow, object>(r => r.Machines))">
                    <CellTemplate>
                        @context.Item.Machines.ToString("N0")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Documents" Sortable="true" HeaderClass="text-right" CellClass="text-right"
                                SortBy="@(new Func<ManufacturerRow, object>(r => r.Documents))">
                    <CellTemplate>
                        <MudLink Href="@($"/admin/documents?manufacturer={Uri.EscapeDataString(context.Item.Key)}")"
                                 Typo="Typo.body2">@context.Item.Documents.ToString("N0")</MudLink>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </AppDataGrid>
    }
</AppPageShell>

@code {
    private sealed record ManufacturerRow(
        string Key, string DisplayName, bool? Enabled, bool HasSource, int Machines, int Documents);

    private List<ManufacturerRow> _rows = [];
    private bool _loading = true;
    private bool _loadFailed;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Admin", href: "/admin", icon: Icons.Material.Filled.Dashboard),
        new BreadcrumbItem("Manufacturers", href: "/admin/manufacturers", icon: Icons.Material.Filled.Factory),
    ];

    protected override async Task OnInitializedAsync()
    {
        using var cts = CreateLoadCts(TimeSpan.FromSeconds(30));

        // Best-effort enrichment: key → (DisplayName, Enabled). Failure leaves Enabled = null ("—").
        var sourceLookup = new Dictionary<string, (string DisplayName, bool Enabled)>(StringComparer.OrdinalIgnoreCase);
        try
        {
            await foreach (var s in SourceRepo.StreamAllAsync(cts.Token))
                sourceLookup[s.Id] = (s.DisplayName, s.Enabled);
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("Admin manufacturers: ingestion-source enrichment read timed out; Enabled column degrades to '—'.");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Admin manufacturers: ingestion-source enrichment read failed; Enabled column degrades to '—'.");
        }

        // Core read: stream manufacturer rollup docs and project to ManufacturerRow.
        // Each rollup doc already carries the full per-machine list, so Machines count
        // and Documents sum are computed inline without a cross-partition scan.
        try
        {
            var rows = new List<ManufacturerRow>();
            await foreach (var mfr in Stats.StreamAllManufacturersAsync(cts.Token))
            {
                var key         = mfr.Manufacturer;
                var displayName = mfr.ManufacturerDisplayName ?? key;
                var machines    = mfr.Machines.Count;
                var documents   = mfr.Machines.Sum(m => m.DocCount);

                var found = sourceLookup.TryGetValue(key, out var src);
                rows.Add(new ManufacturerRow(
                    Key:         key,
                    DisplayName: found ? src.DisplayName : displayName,
                    Enabled:     found ? src.Enabled     : null,
                    HasSource:   found,
                    Machines:    machines,
                    Documents:   documents));
            }

            _rows = rows
                .OrderBy(r => r.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("Admin manufacturers: catalog stats stream timed out after 30 s.");
            _loadFailed = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load manufacturers from catalog stats.");
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }
}

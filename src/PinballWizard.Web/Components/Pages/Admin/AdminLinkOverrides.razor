@page "/admin/link-overrides"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inherits AdminPageBase

@* AdminLinkOverrides — /admin/link-overrides admin-configured document-to-machine mapping view.
 *
 * Public-read after the admin showcase split: override rows are visible to everyone;
 * New Override + Delete actions are gated by _isAdmin (UI) and AdminActionGuard (server).
 * CreatedBy and Notes columns are redacted for anonymous viewers (operator identity).
 *
 * ADR-0008  — MudBlazor strict
 * ADR-0009  — Entra External ID auth
 * ADR-0026  § 1 — routing inventory (/admin/link-overrides)
 *@

@using PinballWizard.Application.Persistence
@using PinballWizard.Core.Models

@inject ILinkOverrideRepository OverrideRepo
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<AdminLinkOverrides> Logger
@inject PinballWizard.Web.Security.AdminActionGuard Guard

<PageTitle>Link Overrides — PinballWizard Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <AppPageHeader Title="Link Overrides"
                   Subtitle="Admin-configured document-to-machine mappings."
                   Breadcrumbs="@_breadcrumbs">
        <Actions>
            @if (_isAdmin)
            {
                <MudButton data-testid="overrides-new-button"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialogAsync">
                    New Override
                </MudButton>
            }
        </Actions>
    </AppPageHeader>

    @if (_loading)
    {
        <AdminLoadingBar Label="Loading link overrides" />
    }

    @if (_loadFailed)
    {
        <AppErrorAlert data-testid="overrides-load-failed">
            Link overrides could not be loaded. Please refresh the page or check Cosmos connectivity.
        </AppErrorAlert>
    }

    <AppDataGrid T="LinkOverrideRow"
                 Items="@_overrides"
                 SearchContext="admin-link-overrides"
                 data-testid="admin-link-overrides-grid">

        <Columns>
            <PropertyColumn Property="x => x.SourcePattern" Title="Source Pattern" />
            <PropertyColumn Property="x => x.MachineIds" Title="Machine IDs" />
            @if (_isAdmin)
            {
                <PropertyColumn Property="x => x.CreatedBy" Title="Created By" />
            }
            <PropertyColumn Property="x => x.CreatedAt" Title="Created At" />
            @if (_isAdmin)
            {
                <PropertyColumn Property="x => x.Notes" Title="Notes" />
            }
            @if (_isAdmin)
            {
                <TemplateColumn Title="Actions">
                    <CellTemplate>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Error"
                                   data-testid="overrides-delete"
                                   OnClick="@(() => DeleteAsync(context.Item))">
                            Delete
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            }
        </Columns>

        <NoRecordsContent>
            @if (!_loadFailed)
            {
                <AppEmptyState Heading="No overrides configured."
                               Detail="Overrides are created manually to resolve ambiguous or failed document links."
                               data-testid="admin-link-overrides-empty" />
            }
        </NoRecordsContent>

    </AppDataGrid>
</MudContainer>

@* Create Override dialog — gated: only renders for admins *@
@if (_isAdmin)
{
    <MudDialog @bind-Visible="_showCreateDialog">
        <TitleContent>New Link Override</TitleContent>
        <DialogContent>
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_newPattern"
                              Label="Source Pattern"
                              HelperText="Format: discovery_url|DocumentType (e.g. https://sternpinball.com/game/foo/|Manual)"
                              Required="true" />
                <MudTextField @bind-Value="_newMachineIds"
                              Label="Machine IDs"
                              HelperText="Comma-separated OPDB machine IDs. Leave empty to mark as platform-generic." />
                <MudTextField @bind-Value="_newNotes"
                              Label="Notes"
                              Lines="2" />
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _showCreateDialog = false)">Cancel</MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="ConfirmCreateAsync"
                       Disabled="@(string.IsNullOrWhiteSpace(_newPattern) || _createBusy)">
                Create
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private bool _isAdmin;

    private sealed record LinkOverrideRow(
        string SourcePattern,
        string MachineIds,
        string CreatedBy,
        string CreatedAt,
        string? Notes);

    private List<LinkOverrideRow> _overrides = [];
    private bool _loading = true;
    private bool _loadFailed;
    private bool _showCreateDialog;
    private bool _createBusy;
    private string _newPattern = string.Empty;
    private string _newMachineIds = string.Empty;
    private string _newNotes = string.Empty;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Admin", href: "/admin", icon: Icons.Material.Filled.Dashboard),
        new BreadcrumbItem("Link Overrides", href: "/admin/link-overrides", icon: Icons.Material.Filled.LinkOff),
    ];

    // Use OnAfterRenderAsync so the page shell (with the loading spinner) is sent
    // to the client immediately on first render rather than blocking the pre-render
    // pass until Cosmos data returns. The spinner is visible within ~100 ms of
    // navigation; data populates when the query completes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync().ConfigureAwait(true);
    }

    private async Task LoadAsync()
    {
        using var cts = CreateLoadCts(TimeSpan.FromSeconds(30));
        try
        {
            _isAdmin = await Guard.IsAdminAsync(AuthState);
            var all = await OverrideRepo.LoadAllAsync(cts.Token);
            _overrides = all.Values
                .Select(r => new LinkOverrideRow(
                    SourcePattern: r.SourcePattern,
                    MachineIds: string.Join(", ", r.MachineIds),
                    CreatedBy: r.CreatedBy,
                    CreatedAt: r.CreatedAt.ToString("u"),
                    Notes: r.Notes))
                .ToList();
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("Admin link overrides load timed out after 30 s.");
            Snackbar.Add("Overrides load timed out — please refresh.", Severity.Warning);
            _loadFailed = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load admin link overrides.");
            Snackbar.Add($"Failed to load overrides: {ex.Message}", Severity.Error);
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
            SafeStateHasChanged();
        }
    }

    private void OpenCreateDialogAsync()
    {
        _newPattern = string.Empty;
        _newMachineIds = string.Empty;
        _newNotes = string.Empty;
        _showCreateDialog = true;
    }

    private async Task ConfirmCreateAsync()
    {
        if (!await Guard.IsAdminAsync(AuthState))
        {
            Snackbar.Add("Sign in as an administrator to perform this action.", Severity.Warning);
            return;
        }
        if (_createBusy) return;
        _createBusy = true;
        try
        {
            var machineIds = _newMachineIds
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            var record = new LinkOverrideRecord
            {
                SourcePattern = _newPattern.Trim(),
                MachineIds = machineIds,
                CreatedBy = "admin",
                CreatedAt = DateTimeOffset.UtcNow,
                Notes = string.IsNullOrWhiteSpace(_newNotes) ? null : _newNotes.Trim()
            };

            await OverrideRepo.UpsertAsync(record, CancellationToken.None);
            _overrides.Add(new LinkOverrideRow(
                SourcePattern: record.SourcePattern,
                MachineIds: string.Join(", ", record.MachineIds),
                CreatedBy: record.CreatedBy,
                CreatedAt: record.CreatedAt.ToString("u"),
                Notes: record.Notes));
            _showCreateDialog = false;
            Snackbar.Add("Override created.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Link override create failed for pattern {SourcePattern}.", _newPattern);
            Snackbar.Add($"Create failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _createBusy = false;
        }
    }

    private async Task DeleteAsync(LinkOverrideRow row)
    {
        if (!await Guard.IsAdminAsync(AuthState))
        {
            Snackbar.Add("Sign in as an administrator to perform this action.", Severity.Warning);
            return;
        }
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Override",
            $"Remove override for '{row.SourcePattern}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true) return;

        try
        {
            await OverrideRepo.DeleteAsync(row.SourcePattern, CancellationToken.None);
            _overrides.Remove(row);
            Snackbar.Add("Override deleted.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Link override delete failed for pattern {SourcePattern}.", row.SourcePattern);
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }
}

@page "/admin/settings"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@rendermode InteractiveServer

@* AdminSettings — /admin/settings runtime-mutable Wizard configuration.
 *
 * Public-read showcase: anonymous visitors see the live setting VALUES read-only
 * (confidence threshold, cost ceiling, max turns, top-K, min score). All edits,
 * the Save/Reset bar, provenance lines, and the Prompt Templates tab are gated to
 * AdminOnly via _isAdmin (resolved from AdminActionGuard). Every mutation handler
 * also guards server-side via AdminActionGuard before acting.
 *
 * PR-B2 of the admin-settings plan. Edits the WellKnownSettings key set
 * through IAdminSettingsRepository; the running Wizard picks changes up
 * within one repository cache window (2 min), no restart. Layering rule
 * everywhere: stored override → IOptions default; "Reset to default"
 * deletes the override row.
 *
 * Tabs are the sanctioned tabs-over-pages spot (plan Phase 2). All four tabs
 * are live: Guardrails, Conversation, and RAG Retrieval edit WellKnownSettings
 * keys through IAdminSettingsRepository; Prompt Templates manages per-agent
 * prompt overrides (PR-B3, the ADR-0018 amendment) — save-inactive-then-activate,
 * layered over the embedded git default. Prompt Templates is admin-only.
 *
 * ADR-0008 — MudBlazor strict; ADR-0009 — Entra auth (AdminOnly gated per-control).
 *@

@using Microsoft.AspNetCore.Components.Authorization
@using PinballWizard.Application.Ai.Hosting
@using PinballWizard.Application.Persistence
@using PinballWizard.Core.Configuration
@using Microsoft.Extensions.Options

@inject IAdminSettingsRepository SettingsRepo
@inject IOptions<AiFoundryOptions> FoundryOptions
@inject IAgentPromptOverrideRepository PromptRepo
@inject PinballWizard.Application.Ai.EmbeddedResourceAgentPromptProvider EmbeddedPrompts
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject PinballWizard.Web.Security.AdminActionGuard Guard

<PageTitle>Settings — PinballWizard Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <AppPageHeader Title="Wizard Settings"
                   Subtitle="Runtime configuration. Changes apply to live asks within two minutes — no restart. Reset returns a setting to its deployed default."
                   Breadcrumbs="@_breadcrumbs" />

    @if (_loading)
    {
        <AdminLoadingBar Label="Loading settings" data-testid="settings-loading" />
    }
    else if (_loadError is not null)
    {
        <AppErrorAlert data-testid="settings-load-error">
            Settings could not be loaded: @_loadError — the Wizard is still running on its
            last-known values; this page just can't show or edit them right now.
        </AppErrorAlert>
    }
    else
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6"
                 data-testid="settings-tabs">

            <MudTabPanel Text="Guardrails" data-testid="tab-guardrails">
                <MudStack Spacing="6">
                    @{ var conf = Row(WellKnownSettings.ConfidenceThreshold); }
                    <div data-testid="setting-confidence">
                        <MudText Typo="Typo.subtitle1">Confidence threshold</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            Answers scoring below this composite refuse instead (ADR-0017).
                            Range 0.3–0.95. @DefaultHint(conf)
                        </MudText>
                        @if (_isAdmin)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                                <MudSlider T="double" @bind-Value="conf.NumericValue"
                                           Min="0.3" Max="0.95" Step="0.01"
                                           Class="flex-grow-1"
                                           aria-label="Confidence threshold" />
                                <MudText Typo="Typo.h6" data-testid="confidence-value">@conf.NumericValue.ToString("0.00")</MudText>
                                @ResetButton(conf)
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.h6" data-testid="confidence-value-readonly">@conf.NumericValue.ToString("0.00")</MudText>
                        }
                        @ProvenanceLine(conf)
                    </div>

                    @{ var ceiling = Row(WellKnownSettings.PerCallCostCeilingUsdCents); }
                    <div data-testid="setting-ceiling">
                        <MudText Typo="Typo.subtitle1">Per-call cost ceiling (¢)</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            An answer whose model spend exceeds this refuses with CostCeilingHit
                            (ADR-0015). Range 1–100¢. @DefaultHint(ceiling)
                        </MudText>
                        @if (_isAdmin)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                                <MudNumericField T="double" @bind-Value="ceiling.NumericValue"
                                                 Min="1" Max="100" Step="1"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 aria-label="Per-call cost ceiling in cents"
                                                 data-testid="ceiling-input" />
                                @ResetButton(ceiling)
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.h6" data-testid="ceiling-value-readonly">@ceiling.NumericValue.ToString("0")</MudText>
                        }
                        @ProvenanceLine(ceiling)
                    </div>
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="Conversation" data-testid="tab-conversation">
                <MudStack Spacing="6">
                    @{ var turns = Row(WellKnownSettings.MaxConversationTurns); }
                    <div data-testid="setting-turns">
                        <MudText Typo="Typo.subtitle1">Max conversation turns sent to the model</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            The router keeps the newest N completed turns of a conversation
                            (oldest trimmed). Range 1–20 — the API rejects longer histories
                            outright, so values above 20 could never take effect. @DefaultHint(turns)
                        </MudText>
                        @if (_isAdmin)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                                <MudNumericField T="double" @bind-Value="turns.NumericValue"
                                                 Min="1" Max="20" Step="1"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 aria-label="Max conversation turns"
                                                 data-testid="turns-input" />
                                @ResetButton(turns)
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.h6" data-testid="turns-value-readonly">@turns.NumericValue.ToString("0")</MudText>
                        }
                        @ProvenanceLine(turns)
                    </div>
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="RAG Retrieval" data-testid="tab-rag">
                <MudStack Spacing="6">
                    @{ var topK = Row(WellKnownSettings.RetrievalTopK); }
                    <div data-testid="setting-topk">
                        <MudText Typo="Typo.subtitle1">Retrieval top-K</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            Chunks the searchCorpus tool retrieves per query when the model
                            doesn't ask for a specific count (a model-supplied K still wins,
                            clamped). Range 1–20. @DefaultHint(topK)
                        </MudText>
                        @if (_isAdmin)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                                <MudNumericField T="double" @bind-Value="topK.NumericValue"
                                                 Min="1" Max="20" Step="1"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 aria-label="Retrieval top-K"
                                                 data-testid="topk-input" />
                                @ResetButton(topK)
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.h6" data-testid="topk-value-readonly">@topK.NumericValue.ToString("0")</MudText>
                        }
                        @ProvenanceLine(topK)
                    </div>

                    @{ var minScore = Row(WellKnownSettings.RetrievalMinimumScore); }
                    <div data-testid="setting-minscore">
                        <MudText Typo="Typo.subtitle1">Minimum relevance score</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            Hits scoring below this are dropped before the model sees them.
                            Higher = stricter grounding, more refusals; lower = more context,
                            weaker citations. Range 0.0–1.0. @DefaultHint(minScore)
                        </MudText>
                        @if (_isAdmin)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                                <MudSlider T="double" @bind-Value="minScore.NumericValue"
                                           Min="0" Max="1" Step="0.01"
                                           Class="flex-grow-1"
                                           aria-label="Minimum relevance score" />
                                <MudText Typo="Typo.h6" data-testid="minscore-value">@minScore.NumericValue.ToString("0.00")</MudText>
                                @ResetButton(minScore)
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.h6" data-testid="minscore-value-readonly">@minScore.NumericValue.ToString("0.00")</MudText>
                        }
                        @ProvenanceLine(minScore)
                    </div>
                </MudStack>
            </MudTabPanel>

            @if (_isAdmin)
            {
                <MudTabPanel Text="Prompt Templates" data-testid="tab-prompts">
                    <MudStack Spacing="4">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Per-agent prompt overrides (ADR-0018 amendment, 2026-06-12). The embedded
                            git prompt remains the default and version-zero source of truth; an ACTIVE
                            override replaces it at runtime. New versions save inactive — activating is
                            the deliberate second step. The Wizard picks changes up within ~2 minutes
                            (prompt-version drift rebuilds the agents), and changed prompts invalidate
                            cached answers automatically.
                        </MudText>

                        <MudSelect T="string" Label="Agent"
                                   Value="_selectedAgent" ValueChanged="OnAgentSelectedAsync"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   data-testid="prompt-agent-select">
                            @foreach (var name in PinballWizard.Application.Ai.AgentName.All)
                            {
                                <MudSelectItem Value="@name">@name</MudSelectItem>
                            }
                        </MudSelect>

                        @if (_selectedAgent is not null)
                        {
                            <MudText Typo="Typo.subtitle2" data-testid="prompt-status">
                                @(_activeOverride is null
                                    ? "Using the embedded default."
                                    : $"Override v{_activeOverride.Version} active — {_activeOverride.UpdatedBy}, {_activeOverride.UpdatedAtUtc:yyyy-MM-dd HH:mm} UTC.")
                            </MudText>

                            <MudTextField T="string" @bind-Value="_promptDraft"
                                          Variant="Variant.Outlined"
                                          Lines="16"
                                          aria-label="Prompt content"
                                          data-testid="prompt-editor" />

                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="SaveNewPromptVersionAsync"
                                           Disabled="@(string.IsNullOrWhiteSpace(_promptDraft) || _promptBusy)"
                                           data-testid="prompt-save-button">
                                    Save as new version
                                </MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Secondary"
                                           OnClick="RevertPromptToDefaultAsync"
                                           Disabled="@(_activeOverride is null || _promptBusy)"
                                           data-testid="prompt-revert-button">
                                    Revert to embedded default
                                </MudButton>
                            </MudStack>

                            <MudExpansionPanels Elevation="0">
                                <MudExpansionPanel Text="View embedded default" data-testid="prompt-default-panel">
                                    <pre class="prompt-default-view" data-testid="prompt-default-content">@_embeddedDefault</pre>
                                </MudExpansionPanel>
                            </MudExpansionPanels>

                            @if (_promptVersions.Count > 0)
                            {
                                <MudText Typo="Typo.subtitle1">Versions</MudText>
                                <MudStack Spacing="1" data-testid="prompt-version-list">
                                    @foreach (var v in _promptVersions.OrderByDescending(v => v.Version))
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2"
                                                  data-testid="@($"prompt-version-{v.Version}")">
                                            <MudText Typo="Typo.body2" Style="min-width: 3rem">v@(v.Version)</MudText>
                                            @if (v.IsActive)
                                            {
                                                <AppStatusChip Color="Color.Success"
                                                               data-testid="@($"prompt-active-chip-{v.Version}")">active</AppStatusChip>
                                            }
                                            else
                                            {
                                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                                           OnClick="@(() => ActivatePromptVersionAsync(v.Version))"
                                                           Disabled="_promptBusy"
                                                           data-testid="@($"prompt-activate-{v.Version}")">
                                                    Activate
                                                </MudButton>
                                            }
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @v.UpdatedBy — @v.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC
                                            </MudText>
                                        </MudStack>
                                    }
                                </MudStack>
                            }
                        }
                    </MudStack>
                </MudTabPanel>
            }
        </MudTabs>

        @if (_isAdmin)
        {
            <MudStack Row="true" Spacing="2" Class="mt-6" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="SaveAsync"
                           Disabled="@(!HasDirtyRows || _saving)"
                           data-testid="save-button">
                    @(_saving ? "Saving…" : "Save changes")
                </MudButton>
                @if (HasDirtyRows)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="dirty-hint">
                        @DirtyCount unsaved @(DirtyCount == 1 ? "change" : "changes")
                    </MudText>
                }
            </MudStack>
        }
    }
</MudContainer>

@code {
    // Cascades when AddCascadingAuthenticationState is wired (auth-configured
    // hosts). Null on the documented no-tenant local-dev path — updatedBy
    // then records the explicit local-dev marker rather than a fake name.
    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Admin", href: "/admin"),
        new("Settings", href: null, disabled: true),
    ];

    private bool _loading = true;
    private bool _saving;
    private bool _isAdmin;
    private string? _loadError;

    private readonly Dictionary<string, SettingRow> _rows = new(StringComparer.Ordinal);

    private SettingRow Row(string key) => _rows[key];

    private bool HasDirtyRows => _rows.Values.Any(r => r.IsDirty);
    private int DirtyCount => _rows.Values.Count(r => r.IsDirty);

    // Use OnAfterRenderAsync so the page shell (with the loading indicator) is sent
    // to the client immediately on first render rather than blocking the pre-render
    // pass until Cosmos settings data returns. The indicator is visible within
    // ~100 ms of navigation; settings populate when the query completes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync().ConfigureAwait(true);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            _isAdmin = await Guard.IsAdminAsync(AuthState).ConfigureAwait(true);

            var stored = (await SettingsRepo.GetAllAsync(CancellationToken.None).ConfigureAwait(true))
                .ToDictionary(r => r.Key, StringComparer.Ordinal);

            _rows.Clear();
            foreach (var key in WellKnownSettings.AllKeys)
            {
                var defaultValue = WellKnownSettings.DefaultFor(key, FoundryOptions.Value);
                stored.TryGetValue(key, out var record);
                _rows[key] = new SettingRow(key, defaultValue, record);
            }
        }
        catch (Exception ex)
        {
            // Degrade visibly (invariant #17): name the failure, make clear
            // the Wizard itself is unaffected, offer nothing interactive.
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (!await Guard.IsAdminAsync(AuthState).ConfigureAwait(true))
        {
            Snackbar.Add("Sign in as an administrator to perform this action.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var updatedBy = await ResolveUpdatedByAsync().ConfigureAwait(true);
            var saved = 0;

            foreach (var row in _rows.Values.Where(r => r.IsDirty))
            {
                var value = row.EditedValueString;
                if (!WellKnownSettings.TryValidate(row.Key, value, out var error))
                {
                    Snackbar.Add($"{row.Key}: {error}", Severity.Error);
                    continue;
                }

                await SettingsRepo.SetAsync(row.Key, value, updatedBy, CancellationToken.None).ConfigureAwait(true);
                saved++;
            }

            if (saved > 0)
            {
                Snackbar.Add(
                    $"Saved {saved} setting{(saved == 1 ? "" : "s")} — live within ~2 minutes.",
                    Severity.Success);
                await LoadAsync().ConfigureAwait(true);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResetAsync(SettingRow row)
    {
        if (!await Guard.IsAdminAsync(AuthState).ConfigureAwait(true))
        {
            Snackbar.Add("Sign in as an administrator to perform this action.", Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Reset to default?",
            $"Removes the stored override for {row.Key}; the Wizard reverts to the deployed default ({row.DefaultValueString}) within ~2 minutes.",
            yesText: "Reset", cancelText: "Cancel").ConfigureAwait(true);

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await SettingsRepo.DeleteAsync(row.Key, CancellationToken.None).ConfigureAwait(true);
            Snackbar.Add($"{row.Key} reset to default.", Severity.Success);
            await LoadAsync().ConfigureAwait(true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Reset failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task<string> ResolveUpdatedByAsync()
    {
        if (AuthState is null)
        {
            return "admin (local-dev, auth not configured)";
        }

        var state = await AuthState.ConfigureAwait(true);
        return state.User.Identity?.Name ?? "admin (authenticated, no name claim)";
    }

    private RenderFragment ResetButton(SettingRow row) => __builder =>
    {
        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary"
                   OnClick="@(() => ResetAsync(row))"
                   Disabled="@(!row.HasOverride)"
                   data-testid="@($"reset-{row.Key}")">
            Reset to default
        </MudButton>
    };

    private RenderFragment ProvenanceLine(SettingRow row) => __builder =>
    {
        @if (_isAdmin && row.HasOverride)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary"
                     data-testid="@($"provenance-{row.Key}")">
                Overridden by @row.UpdatedBy on @row.UpdatedAtUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'")
            </MudText>
        }
    };

    private string DefaultHint(SettingRow row) => $"Default: {row.DefaultValueString}.";

    // ── Prompt Templates tab state (PR-B3) ───────────────────────────────
    private string? _selectedAgent;
    private AgentPromptOverride? _activeOverride;
    private IReadOnlyList<AgentPromptOverride> _promptVersions = [];
    private string _promptDraft = string.Empty;
    private string _embeddedDefault = string.Empty;
    private bool _promptBusy;

    private async Task OnAgentSelectedAsync(string agent)
    {
        _selectedAgent = agent;
        await LoadPromptStateAsync().ConfigureAwait(true);
    }

    private async Task LoadPromptStateAsync()
    {
        if (_selectedAgent is null)
        {
            return;
        }

        // Prompt fields hold IP and must not be populated for a non-admin. The tab
        // that renders them is admin-gated; this makes the data flow safe by
        // construction, not just by render position.
        if (!await Guard.IsAdminAsync(AuthState).ConfigureAwait(true))
        {
            return;
        }

        _promptBusy = true;
        try
        {
            _embeddedDefault = EmbeddedPrompts.GetPrompt(_selectedAgent);
            _activeOverride = await PromptRepo.GetActiveAsync(_selectedAgent, CancellationToken.None).ConfigureAwait(true);
            _promptVersions = await PromptRepo.GetVersionsAsync(_selectedAgent, CancellationToken.None).ConfigureAwait(true);
            // Editor preloads the live content: active override or default.
            _promptDraft = _activeOverride?.Content ?? _embeddedDefault;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Prompt state load failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _promptBusy = false;
        }
    }

    private async Task SaveNewPromptVersionAsync()
    {
        if (!await Guard.IsAdminAsync(AuthState).ConfigureAwait(true))
        {
            Snackbar.Add("Sign in as an administrator to perform this action.", Severity.Warning);
            return;
        }

        if (_selectedAgent is null || string.IsNullOrWhiteSpace(_promptDraft))
        {
            return;
        }

        _promptBusy = true;
        try
        {
            var updatedBy = await ResolveUpdatedByAsync().ConfigureAwait(true);
            var saved = await PromptRepo.SaveNewVersionAsync(_selectedAgent, _promptDraft, updatedBy, CancellationToken.None).ConfigureAwait(true);
            // Deliberate two-step: saving never activates. Fabricating a live
            // prompt out of a draft save would be the silent-mutation class.
            Snackbar.Add($"Saved v{saved.Version} (inactive) — activate it from the version list when ready.", Severity.Success);
            await LoadPromptStateAsync().ConfigureAwait(true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _promptBusy = false;
        }
    }

    private async Task ActivatePromptVersionAsync(int version)
    {
        if (!await Guard.IsAdminAsync(AuthState).ConfigureAwait(true))
        {
            Snackbar.Add("Sign in as an administrator to perform this action.", Severity.Warning);
            return;
        }

        if (_selectedAgent is null)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Activate v{version}?",
            $"The live {_selectedAgent} agent rebuilds with this prompt within ~2 minutes, and cached answers for the old prompt stop being served.",
            yesText: "Activate", cancelText: "Cancel").ConfigureAwait(true);
        if (confirmed != true)
        {
            return;
        }

        _promptBusy = true;
        try
        {
            await PromptRepo.ActivateAsync(_selectedAgent, version, CancellationToken.None).ConfigureAwait(true);
            Snackbar.Add($"{_selectedAgent} v{version} activated.", Severity.Success);
            await LoadPromptStateAsync().ConfigureAwait(true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Activate failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _promptBusy = false;
        }
    }

    private async Task RevertPromptToDefaultAsync()
    {
        if (!await Guard.IsAdminAsync(AuthState).ConfigureAwait(true))
        {
            Snackbar.Add("Sign in as an administrator to perform this action.", Severity.Warning);
            return;
        }

        if (_selectedAgent is null)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Revert to embedded default?",
            $"Deactivates all {_selectedAgent} overrides; the agent rebuilds with the git-source prompt within ~2 minutes. Stored versions remain and can be re-activated.",
            yesText: "Revert", cancelText: "Cancel").ConfigureAwait(true);
        if (confirmed != true)
        {
            return;
        }

        _promptBusy = true;
        try
        {
            await PromptRepo.DeactivateAsync(_selectedAgent, CancellationToken.None).ConfigureAwait(true);
            Snackbar.Add($"{_selectedAgent} reverted to the embedded default.", Severity.Success);
            await LoadPromptStateAsync().ConfigureAwait(true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Revert failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _promptBusy = false;
        }
    }

    // One editable setting. NumericValue is the bound editor state; dirty =
    // differs from the effective (stored-or-default) starting value.
    private sealed class SettingRow
    {
        public SettingRow(string key, string defaultValue, AdminSettingRecord? stored)
        {
            Key = key;
            DefaultValueString = defaultValue;
            HasOverride = stored is not null;
            UpdatedBy = stored?.UpdatedBy;
            UpdatedAtUtc = stored?.UpdatedAtUtc;

            var effective = stored?.Value ?? defaultValue;
            _initial = double.Parse(effective, System.Globalization.CultureInfo.InvariantCulture);
            NumericValue = _initial;
        }

        private readonly double _initial;

        public string Key { get; }
        public string DefaultValueString { get; }
        public bool HasOverride { get; }
        public string? UpdatedBy { get; }
        public DateTimeOffset? UpdatedAtUtc { get; }

        public double NumericValue { get; set; }

        public bool IsDirty => Math.Abs(NumericValue - _initial) > 0.0001;

        public string EditedValueString =>
            NumericValue.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }
}

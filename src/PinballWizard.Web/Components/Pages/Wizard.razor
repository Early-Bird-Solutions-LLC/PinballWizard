@page "/wizard"
@page "/wizard/q/{Slug}"
@rendermode InteractiveServer
@attribute [AllowAnonymous]

@* Wave 2 PR-D-stream. Replaces WizardStreamingPlaceholder (Wave 1 F2 bridge)
   with WizardAnswerStream — the real streaming delight surface.

   Route /wizard — direct access; WizardAnswerStream renders in Idle state
   with an empty question input.

   Route /wizard/q/{Slug} — D-landing's SeedQuestionGrid navigates here when
   the user clicks a seed question card. The Slug parameter is forwarded to
   WizardAnswerStream via the Question parameter, which auto-submits on init
   so the user immediately sees the streaming answer.

   The Question text is resolved from the Slug via the compiled-in fallback
   questions list embedded in the landing page. For Wave 2 the Slug is passed
   directly as the question text when the landing page navigates as a URL-
   encoded question (see Index.razor → SeedQuestionGrid → OnCardClick for the
   navigation pattern: Nav.NavigateTo($"/wizard/q/{slug}") where slug is the
   URL-encoded question slug from the seed question).

   WizardAnswerStream handles the pre-fill + auto-submit when Question is set.

   ADR-0026 § 1 + follow-up 2026-06-10 — /wizard anonymous, server render mode
   (InteractiveServer; auto mode retired — see the ADR follow-up).
   ADR-0026 § 6 — WizardAnswerStream is one of the four locked delight surfaces.
   ADR-0008     — MudBlazor strict; only MudContainer used here as chrome. *@

@using PinballWizard.Application.Landing
@using PinballWizard.Web.Clients
@inject IWizardLandingClient LandingClient
@inject ILogger<Wizard> Logger

<PageTitle>PinballWizard — Ask the Wizard</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <WizardAnswerStream Question="@_resolvedQuestion" />
</MudContainer>

@code {
    // Slug from /wizard/q/{slug} route. Null when the user navigated directly
    // to /wizard (no pre-fill).
    [Parameter]
    public string? Slug { get; set; }

    // Question text from /wizard?q={text} — the navigation shape the landing
    // page actually produces (Index.razor OnQuestionSubmitted escapes the
    // full question into the query string for both seed-card clicks and
    // hero-input submits). Only the slug ROUTE was handled before, so every
    // landing hand-off arrived at the bare Idle page with an empty input
    // (observed live 2026-06-10). Takes priority over Slug: it carries the
    // exact question text, no lookup needed.
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    // Resolved question text. Null for /wizard (Idle state); populated from
    // ?q= directly or from /wizard/q/{slug} after lookup.
    private string? _resolvedQuestion;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Q))
        {
            _resolvedQuestion = Q;
            return;
        }

        if (string.IsNullOrEmpty(Slug))
        {
            _resolvedQuestion = null;
            return;
        }

        // Attempt to resolve the slug to a question text via the landing
        // client (which returns the seeded questions with their slugs).
        // On failure (endpoint down / timeout), fall back to using the slug
        // itself as the question so the UX doesn't break.
        _resolvedQuestion = await ResolveSlugAsync(Slug).ConfigureAwait(false);
    }

    private async Task<string> ResolveSlugAsync(string slug)
    {
        try
        {
            var landing = await LandingClient
                .GetLandingAsync(CancellationToken.None)
                .ConfigureAwait(false);

            if (landing?.SeedQuestions is not null)
            {
                var match = landing.SeedQuestions.FirstOrDefault(q =>
                    string.Equals(q.Slug, slug, StringComparison.OrdinalIgnoreCase));
                if (match is not null)
                    return match.Question;
            }
        }
        catch (Exception ex)
        {
            // Landing endpoint unavailable — fall back to slug as question
            // text. This catch is deliberately broad: the method's contract
            // is "always return a question string". The original closed list
            // (HttpRequestException / InvalidOperationException /
            // TaskCanceledException / TimeoutException) missed Polly's
            // BrokenCircuitException — when the landing endpoint was down
            // long enough to open the standard resilience circuit breaker,
            // every seed-card click threw through the component lifecycle
            // and TERMINATED the user's entire Blazor circuit (observed
            // live 2026-06-10: one card click made the whole page inert).
            // Debug-level so ops can diagnose "slug became question"
            // without noise on expected outages.
            Logger.LogDebug(ex,
                "Landing lookup failed for slug {Slug}; using slug-as-question fallback.",
                SanitizeForLog(slug));
        }

        // Slug-as-question fallback: convert hyphens to spaces and title-case.
        // e.g., "how-does-wizard-mode-work" → "how does wizard mode work"
        return slug.Replace('-', ' ');
    }

    // Prevent log-forging: CR/LF in a user-supplied value can inject
    // fake log entries or break structured-log parsers.
    private static string SanitizeForLog(string value) =>
        string.IsNullOrEmpty(value) ? value : value.Replace('\r', '_').Replace('\n', '_');
}

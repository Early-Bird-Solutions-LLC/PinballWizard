@namespace PinballWizard.Web.Components.Shared

@* Native <li> — the marker is drawn by CSS list-style on the parent <ul>
   (.app-bullet-list), not an icon component, keeping the static list free of
   interactive ARIA. See AppBulletList.razor for the a11y rationale. *@
<li class="app-bullet-item">
    @ChildContent
</li>

@code {
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = null!;
}

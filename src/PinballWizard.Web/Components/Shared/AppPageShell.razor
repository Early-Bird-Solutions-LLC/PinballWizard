@namespace PinballWizard.Web.Components.Shared

@* AppPageShell — the shared page frame for every grid/list view.
 *
 * Owns the two things that were previously hand-rolled (and drifting) on each
 * page: the MudContainer (width + vertical rhythm) and the AppPageHeader. This
 * is the single place to adjust page layout — change it here and every grid page
 * moves together (the "adjust once" requirement).
 *
 * Width: defaults to MaxWidth.False (full-width, minus MudContainer's responsive
 * side gutters) so wide grids use the available horizontal space instead of
 * being pinned to ~1200px on a 2560px monitor. Data grids with many columns then
 * fit without a horizontal scrollbar. A page that wants a narrower measure can
 * override MaxWidth.
 *
 * Header: rendered only when Title is set. Pages whose heading depends on loaded
 * data (e.g. /manufacturers/{key}) omit Title and render their own header inside
 * ChildContent — they still get the identical container so layout stays uniform.
 * Such a page can still hand the shell its Breadcrumbs: with no Title, the shell
 * renders the trail alone (above ChildContent), so the crumbs survive the loading /
 * not-found / load-failed branches that a post-load header never reaches.
 *
 * ADR-0008 — MudBlazor strict   ADR-0046 — shared Blazor component library
 *@

<MudContainer MaxWidth="@MaxWidth" Class="@Class">
    @if (Title is not null)
    {
        <AppPageHeader Title="@Title"
                       Subtitle="@Subtitle"
                       Breadcrumbs="@Breadcrumbs"
                       Actions="@Actions" />
    }
    else if (Breadcrumbs is not null)
    {
        @* Breadcrumbs without a Title. Detail pages whose heading depends on loaded
         * data (/admin/machines/{id}, /admin/jobs/{job}/executions/{exec}) still owe the
         * user a trail in EVERY state — loading, not-found, load-failed — not just the
         * loaded one. Rendering them here means those pages pass Breadcrumbs to the shell
         * like everyone else instead of hand-rolling a MudBreadcrumbs, and a supplied
         * Breadcrumbs is never silently swallowed just because Title is null.
         *@
        <MudBreadcrumbs Items="@Breadcrumbs" Class="pa-0 mb-4" />
    }

    @* Guarantee exactly one <h1> in EVERY state, by the same argument this file
     * already makes for breadcrumbs a few lines up: a detail page owes the user its
     * identity while loading, when not found, and when the load failed - not only on
     * the happy path. Before this, pages whose header lives inside a loaded-branch
     * @if rendered no heading at all in the other three states, and axe's
     * page-has-heading-one failed on every one (#790).
     *
     * Hidden rather than visible because these pages deliberately have no title bar
     * in their visual design; the heading is for the document outline and screen
     * readers. Falls back to the last breadcrumb, which names the page and is
     * already supplied in every state.
     *@
    @if (Title is null && AccessibleHeading is not null)
    {
        <h1 class="pw-visually-hidden">@AccessibleHeading</h1>
    }

    @ChildContent
</MudContainer>

@code {
    // Page heading. When null, no AppPageHeader is rendered (the page supplies
    // its own header inside ChildContent).
    [Parameter] public string? Title { get; set; }

    [Parameter] public string? Subtitle { get; set; }

    // Accessible page heading used only when Title is null - i.e. when the page
    // renders no visible header. Defaults to the final breadcrumb.
    [Parameter] public string? AccessibleTitle { get; set; }

    private string? AccessibleHeading =>
        AccessibleTitle ?? (Breadcrumbs is { Count: > 0 } b ? b[^1].Text : null);
    [Parameter] public IReadOnlyList<BreadcrumbItem>? Breadcrumbs { get; set; }

    // Header action slot (buttons beside the title). Has no effect when Title is
    // null — with no header rendered there is nowhere for actions to go. A page
    // that needs actions without the shell's header renders its own header inside
    // ChildContent instead.
    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Container width. Full-width by default to use the available horizontal space.
    [Parameter] public MaxWidth MaxWidth { get; set; } = MaxWidth.False;

    // Vertical rhythm. Symmetric padding so pages breathe above and below.
    [Parameter] public string Class { get; set; } = "py-6";
}

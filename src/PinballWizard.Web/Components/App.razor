<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="app.css" />
    @* Scoped-CSS bundle (every Components/**/*.razor.css). Without this link
       none of the per-component styles ship — see ScopedCssBundleTests. *@
    <link rel="stylesheet" href="PinballWizard.Web.styles.css" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script>
        (function () {
            try {
                var t = localStorage.getItem('pinwiz.theme');
                if (t && t !== 'modern-lcd') document.documentElement.classList.add('theme-' + t);
                var m = localStorage.getItem('pinwiz.motion');
                if (m) document.documentElement.dataset.motion = m;
            } catch (_) { }
        })();
    </script>
    <script src="app.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>

@* LandingHero — top-of-page hero for the public / route.
 *
 * Renders the PinballWizard brand name, a 1–2 sentence tagline explaining
 * what the application does, and a prominent MudTextField question input
 * that autofocuses on page load. The hero is hardcoded — it does NOT depend
 * on /api/wizard/landing — so it renders immediately even when the landing
 * endpoint is unavailable.
 *
 * The question input is two-way bound to the QuestionText parameter so the
 * parent (Index.razor) can pre-fill it when a seed question card is clicked.
 * QuestionSubmitted is invoked when the user presses Enter or clicks "Ask".
 *
 * Custom delight surface — LandingHero is within the four locked delight
 * surfaces (ADR-0026 § 6, CLAUDE.md invariant 14):
 *   WizardAnswerStream | RefusalPanel | CitationStrip family | TiltPage/TiltErrorBoundary
 * LandingHero is the landing-surface equivalent and is explicitly in scope
 * per ADR-0026 § Landing surface.
 *
 * Hero prominence: modern-lcd.md §"Empty/landing state" — "cinematic flourish".
 * Barlow Condensed display headline (h1), eyebrow tagline, ALL-CAPS brand name.
 * Prototype reference: docs/ui/prototypes/empty-landing.html.
 *
 * ADR-0008 — MudBlazor strict for chrome. Hero input is MudTextField.
 * ADR-0026 § Landing surface.
 *@

@inject NavigationManager Nav

<div class="landing-hero" data-testid="landing-hero">
    <div class="landing-hero__brand">
        <p class="landing-hero__eyebrow" aria-hidden="true" data-testid="landing-hero-eyebrow">
            A COMMUNITY-RESOURCE PINBALL WIZARD
        </p>
        <MudText Typo="Typo.h1" Class="landing-hero__title" data-testid="landing-hero-title">
            PINBALLWIZARD
        </MudText>
        <MudText Typo="Typo.body1" Class="landing-hero__tagline" data-testid="landing-hero-tagline">
            Ask anything about pinball — every answer cites its source and routes you to the community.
        </MudText>
    </div>

    <div class="landing-hero__input-row" data-testid="landing-hero-input">
        <MudTextField @ref="_inputRef"
                      @bind-Value="QuestionText"
                      Immediate="true"
                      Placeholder="Ask the Wizard…"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.ArrowForward"
                      AdornmentColor="Color.Primary"
                      AdornmentAriaLabel="Ask"
                      OnAdornmentClick="OnSubmitClick"
                      FullWidth="true"
                      AutoFocus="true"
                      aria-label="Question input"
                      OnKeyDown="OnKeyDown" />
    </div>
</div>

@code {
    private MudTextField<string>? _inputRef;

    // Two-way bound by the parent (Index.razor). Pre-filled when a seed
    // question card is clicked.
    [Parameter]
    public string QuestionText { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> QuestionTextChanged { get; set; }

    // Invoked when the user submits (Enter key or adornment click).
    [Parameter]
    public EventCallback<string> QuestionSubmitted { get; set; }

    private async Task OnSubmitClick()
    {
        if (!string.IsNullOrWhiteSpace(QuestionText))
        {
            await QuestionSubmitted.InvokeAsync(QuestionText).ConfigureAwait(false);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(QuestionText))
        {
            await QuestionSubmitted.InvokeAsync(QuestionText).ConfigureAwait(false);
        }
    }
}

@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer"
                       aria-label="Toggle navigation menu" />
        <MudText Typo="Typo.h5" Class="ml-3">
            <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None">PinWiz.ai</MudLink>
        </MudText>
        <MudSpacer />
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <SearchBar Class="mx-4" Placeholder="Search..." NavigateToChat="true" />
        </MudHidden>
        <ThemeToggle @bind-IsDarkMode="_isDarkMode" />
        <LoginButton />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Breakpoint="Breakpoint.Md"
               Elevation="2"
               Variant="@DrawerVariant.Mini">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pt-16 px-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _isDarkMode = true;
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#7B1FA2",
            Secondary = "#FF6F00"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#CE93D8",
            Secondary = "#FFB74D",
            Background = "#0F0F23",
            Surface = "#1A1A2E"
        }
    };

    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}

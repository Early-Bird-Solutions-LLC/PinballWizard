<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>PinballWizard.Web</RootNamespace>
    <AssemblyName>PinballWizard.Web</AssemblyName>

    <!--
      UserSecretsId scopes secrets to this project for local dev.
      The Entra External ID config (AzureAd section) arrives in a
      future PR — this id reserves the slot.
    -->
    <UserSecretsId>pinwiz-web-dev</UserSecretsId>

    <!--
      Aspire publishes this as a Bicep-manifest resource. Disable locked-mode
      restore for the same reason as AppHost — AppHost's RID-specific binaries
      cause cross-platform lock-file failures in CI. Web carries no
      RID-specific content today, but keeping the restore policy aligned
      simplifies future AppHost Bicep-manifest publish flows.
      Remove this opt-out if/when the lock-file story for web-SDK projects
      is clarified.
    -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      InternalsVisibleTo: PinballWizard.Web.Tests accesses internal types
      (ClientDegradationStore) for DI registration in bUnit tests.
      Pattern matches PinballWizard.Application.csproj (InternalsVisibleTo
      for PinballWizard.Scraper.Tests). The concrete store is internal so
      callers must depend on IClientDegradationStore; the test project is
      the single exempted consumer.
    -->
    <InternalsVisibleTo Include="PinballWizard.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      MudBlazor is the sole chrome library per ADR-0008. Pin to a
      .NET 10 / Blazor Web App compatible release.
    -->
    <PackageReference Include="MudBlazor" />

    <!--
      Microsoft.AspNetCore.Components.WebAssembly.Server enables Kestrel
      to serve the WASM bootstrap, framework static files, and the
      blazor.webassembly.js runtime script required by auto-render mode
      (ADR-0026 § 1). Without this package the Server cannot deliver the
      WASM payload to the browser.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />

    <!--
      Microsoft.Identity.Web wires Entra External ID auth per ADR-0009.
      Auth config lives in appsettings.json § AzureAd — intentionally
      empty in Wave 1; real tenant config arrives in a follow-up PR.
    -->
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Microsoft.Identity.Web.UI" />

    <!--
      Data Protection key-ring persistence for multi-replica ACA hosting
      (ADR-0026 follow-up 2026-06-10): keys live in blob storage, wrapped
      with a Key Vault key, so antiforgery tokens and circuit handshakes
      survive replica fan-out and restarts. Blazor Server on Container
      Apps requires this alongside ingress session affinity.
    -->
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Azure.Identity" />

    <!--
      Aspire Cosmos client integration. Lets the Web consume the
      ConnectionStrings:cosmos value that the AppHost injects via
      pinwiz-web.WithReference(cosmos) — the local preview-emulator path that
      makes the /admin data pages work in local dev. Mirrors the Cli, which
      already references this. In deployed environments Cosmos:AccountEndpoint
      drives the Managed-Identity path instead and this call is skipped.
    -->
    <PackageReference Include="Aspire.Microsoft.Azure.Cosmos" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PinballWizard.Application/PinballWizard.Application.csproj" />
    <ProjectReference Include="../PinballWizard.Infrastructure/PinballWizard.Infrastructure.csproj" />
    <ProjectReference Include="../PinballWizard.ServiceDefaults/PinballWizard.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Auto-mode wiring per ADR-0026 § 1: the Server hosts both Server-
      rendered components and WASM-fallback components. The Client project
      is referenced so its @page components are discoverable by the
      Server's router (AddAdditionalAssemblies in Program.cs) and so
      Aspire publishes its WASM artifacts alongside the Server.
    -->
    <ProjectReference Include="../PinballWizard.Web.Client/PinballWizard.Web.Client.csproj" />
  </ItemGroup>

</Project>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Cosmos": {
    "ApplicationName": "pinwiz-cli"
  },
  "Rag": {
    "Ingestion": {
      "AcceptedDocumentTypes": [ "Manual", "ServiceBulletin" ],
      "MaxFailuresPerDocument": 3,
      "ReconcileOnStartup": false
    },
    "ChangeFeed": {
      "SourceContainerName": "scraped_documents",
      "LeaseContainerName": "rag_leases",
      "ProcessorName": "rag-indexer",
      "StartFromBeginning": true
    }
  },
  "Scraper": {
    "BaseUrl": "https://sternpinball.com",
    "DataPath": "data",
    "PageLoadDelayMs": 2000,
    "MaxConcurrentDownloads": 3,
    "HttpTimeoutSeconds": 120,
    "MaxFileSizeBytes": 524288000,
    "MaxRetries": 3,
    "InitialRetryDelayMs": 1000
  },
  "Politeness": {
    "UserAgent": "PinballWizard/0.1 (+https://github.com/Early-Bird-Solutions-LLC/PinballWizard; polite-scraper)",
    "RequestDelayMs": 2000,
    "Max429Streak": 3,
    "RespectRobotsTxt": true,
    "RobotsTxtPath": "/robots.txt",
    "RobotsTxtTtlSeconds": 3600
  },
  "Jjp": {
    "BaseUrl": "https://jerseyjackpinball.com",
    "SitemapPath": "/sitemap.xml",
    "PinballMachinesCollectionSlug": "pinball-machines-for-sale"
  },
  "Ap": {
    "BaseUrl": "https://www.american-pinball.com",
    "SitemapPath": "/sitemap.xml",
    "GamePathPrefix": "/games/"
  },
  "Spooky": {
    "BaseUrl": "https://www.spookypinball.com",
    "PagesEndpointPath": "/wp-json/wp/v2/pages",
    "PageSize": 100,
    "S3Host": "spookypinball.s3.us-east-2.amazonaws.com",
    "MaxPagesToFetch": 50
  },
  "PinballBrothers": {
    "BaseUrl": "https://www.pinballbrothers.com",
    "PagesEndpointPath": "/wp-json/wp/v2/pages",
    "PageSize": 100,
    "MaxPagesToFetch": 50,
    "GameSlugSuffix": "-pinball"
  },
  "BarrelsOfFun": {
    "BaseUrl": "https://shop.kollectfun.com",
    "MachinesCategoryPath": "/product-category/machines/",
    "ProductPathPrefix": "/product/"
  },
  "ChicagoGaming": {
    "BaseUrl": "https://www.chicago-gaming.com",
    "MachinesIndexPath": "/coinop/",
    "GamePathPrefix": "/coinop/"
  },
  "Multimorphic": {
    "BaseUrl": "https://www.multimorphic.com",
    "SitemapPath": "/wp-sitemap.xml",
    "MultimorphicGameKitsPathPrefix": "/store/p3-game-kits/multimorphic-game-kits/"
  }
}

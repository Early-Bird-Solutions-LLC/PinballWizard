<Project Sdk="Aspire.AppHost.Sdk/13.1.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>9f2b7c1e-pinball-wizard-apphost-001</UserSecretsId>
    <!--
      Aspire AppHost dictates a number of analyzer rules that fire on the
      generated DCP wiring code. The wider Directory.Build.props enforces
      "warnings are errors"; we DO NOT relax that here. Instead, project-level
      NoWarn entries below are reserved for the same per-rule justification
      pattern used in Directory.Build.props.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PinballWizard.Cli\PinballWizard.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire.Hosting.AppHost is implicit in Aspire.AppHost.Sdk/13.1.1 -->
    <PackageReference Include="Aspire.Hosting.Azure.CosmosDB" Version="13.1.1" />
  </ItemGroup>

</Project>

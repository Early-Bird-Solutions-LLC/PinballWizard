<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PinballWizard.Infrastructure</RootNamespace>
    <AssemblyName>PinballWizard.Infrastructure</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" />
    <PackageReference Include="Azure.Identity" />
    <!-- Azure.AI.Projects 2.0 is GA (April 2026) and is the data-plane SDK
         for the Foundry project endpoint per ADR-0014. Phase 3 PR 2a uses
         it for the post-deploy smoke probe (AzureFoundrySmokeProbe);
         Wave 2 PR 4 will add Microsoft.Agents.AI.Foundry (preview, the
         Microsoft Agent Framework wrapper) for IAiRouter + agent
         construction via AsAIAgent. -->
    <PackageReference Include="Azure.AI.Projects" />
    <!-- Microsoft.Agents.AI.Foundry is the Foundry-specific provider for
         the Microsoft Agent Framework. It exposes AIProjectClient.AsAIAgent
         (the Responses Agent extension) which the FoundryAgentFactory
         uses to construct the four AIAgent instances per ADR-0014. GA
         at 1.4.0 — better than the "preview" status assumed at ADR-0014
         drafting time. P3-R4 narrows further: now both the data-plane
         SDK (Azure.AI.Projects) AND the Microsoft Agent Framework
         providers are GA. -->
    <PackageReference Include="Microsoft.Agents.AI.Foundry" />
    <!-- Azure.Search.Documents is the data-plane SDK for Azure AI Search.
         Phase 4 W1-4 uses it for the post-deploy smoke probe
         (AzureAiSearchSmokeProbe — verifies endpoint reachability + AAD
         auth via DefaultAzureCredential). Wave 2 W2-3 extends consumption
         for index creation + document upsert (AiSearchRagIndexer per
         ADR-0021); Wave 3 W3-3 adds hybrid-retrieval queries via
         AiSearchRagRetriever. The 12.0.0 line is the GA major covering
         the v2026-04-01 service API surface; vector, semantic, and hybrid
         query shapes used by ADR-0021/0024 are unchanged from 11.7.0. -->
    <PackageReference Include="Azure.Search.Documents" />
    <!-- Azure.AI.OpenAI 2.x wraps the OpenAI 2.x client with Azure
         AAD auth + Foundry-hosted-deployment routing. Phase 4 W3-3
         (AiSearchRagRetriever) uses AzureOpenAIClient.GetEmbeddingClient
         to embed query text against text-embedding-3-large per ADR-0020;
         W2-3 will reuse the same embedding surface for indexing-side
         vectorization. Constructed with DefaultAzureCredential — no
         API key in code or config. -->
    <PackageReference Include="Azure.AI.OpenAI" />
    <!-- PdfPig (namespace UglyToad.PdfPig) is the pure-managed PDF reader
         used by Phase 4 W1-5's PdfPigDocumentTextExtractor. Reads text +
         outline from PDF streams; no native dependencies; compatible
         with the showcase posture (no GPL/AGPL like iText 7 community
         license). 0.1.x is the current stable line; the writer surface
         is minimal but sufficient for unit-test fixtures. Wave 2 W2-2
         (HybridChunker) consumes the extractor's output but doesn't
         take a direct dep. -->
    <PackageReference Include="PdfPig" />
    <!-- Azure.ResourceManager.CosmosDB drives ARM (control-plane) database/container
         CRUD for `CosmosBootstrapper.EnsureCreatedAsync`. Cosmos's data-plane RBAC
         genuinely does not include `sqlDatabases/write` (and there is no valid
         wildcard that covers it; PR #62 attempted `sqlDatabases/*` and Azure's
         deploy-time validation rejected it as "not a valid SQL data action").
         Schema bootstrap therefore uses ARM, which checks Azure RBAC — satisfied
         in dev by the developer's subscription Owner inheritance and in prod by
         the production identity holding `Cosmos DB Operator` at account scope.
         The data-plane SDK (Microsoft.Azure.Cosmos) below remains the canonical
         path for runtime item CRUD. -->
    <PackageReference Include="Azure.ResourceManager.CosmosDB" />
    <PackageReference Include="Microsoft.Azure.Cosmos" />
    <!-- IMemoryCache + MemoryCacheOptions for SystemStatusProvider's
         stampede-safe TTL cache (PR-L3). AddMemoryCache() extension is
         included in this package. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- IHealthCheck + HealthCheckResult + HealthCheckContext + the
         AddHealthChecks().AddCheck<T>() registration extension. Per
         ADR-0025 § 8 the Infrastructure layer owns CosmosHealthCheck
         (it's Cosmos-specific); this package gives us the abstractions
         without taking a Microsoft.AspNetCore.App framework reference. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Playwright" />
    <!-- Microsoft.Azure.Cosmos uses Newtonsoft.Json internally for some
         connection-management paths. Our SystemTextJsonCosmosSerializer
         handles document (de)serialization, but the SDK's transitive check
         still requires Newtonsoft to be explicitly versioned. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PinballWizard.Core/PinballWizard.Core.csproj" />
    <ProjectReference Include="../PinballWizard.Application/PinballWizard.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests pin the deserialization contract for the internal DTO classes
         used by the Stern Playwright scrapers (LinkRaw, BulletinRaw).
         Playwright's EvaluateArgumentValueConverter calls
         Activator.CreateInstance(t) and assigns properties one by one;
         the contract test asserts a public parameterless ctor exists,
         that JsonPropertyName attributes match the JS-side keys, and that
         every property is settable. JsonPropertyName typos / accidental
         readonly-property changes / accidental positional-record reverts
         would otherwise only surface as "0 results" against the live site.
         See docs/decision-log.md DL-0002 for the full history. -->
    <InternalsVisibleTo Include="PinballWizard.Scraper.Tests" />
    <InternalsVisibleTo Include="PinballWizard.Core.Tests" />
    <InternalsVisibleTo Include="PinballWizard.Application.Tests" />
    <InternalsVisibleTo Include="PinballWizard.Infrastructure.Tests" />
    <!-- Castle DynamicProxy needs this to mock ItemResponse<RawDocumentCosmosRecord> in NSubstitute tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2, " />
  </ItemGroup>

</Project>

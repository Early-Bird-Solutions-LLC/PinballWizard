<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PinballWizard.Infrastructure</RootNamespace>
    <AssemblyName>PinballWizard.Infrastructure</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.4.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- Azure.AI.Projects 2.0 is GA (April 2026) and is the data-plane SDK
         for the Foundry project endpoint per ADR-0014. Phase 3 PR 2a uses
         it for the post-deploy smoke probe (AzureFoundrySmokeProbe);
         Wave 2 PR 4 will add Microsoft.Agents.AI.Foundry (preview, the
         Microsoft Agent Framework wrapper) for IAiRouter + agent
         construction via AsAIAgent. -->
    <PackageReference Include="Azure.AI.Projects" Version="2.0.1" />
    <!-- Microsoft.Agents.AI.Foundry is the Foundry-specific provider for
         the Microsoft Agent Framework. It exposes AIProjectClient.AsAIAgent
         (the Responses Agent extension) which the FoundryAgentFactory
         uses to construct the four AIAgent instances per ADR-0014. GA
         at 1.4.0 — better than the "preview" status assumed at ADR-0014
         drafting time. P3-R4 narrows further: now both the data-plane
         SDK (Azure.AI.Projects) AND the Microsoft Agent Framework
         providers are GA. -->
    <PackageReference Include="Microsoft.Agents.AI.Foundry" Version="1.4.0" />
    <!-- Azure.Search.Documents is the data-plane SDK for Azure AI Search.
         Phase 4 W1-4 uses it for the post-deploy smoke probe
         (AzureAiSearchSmokeProbe — verifies endpoint reachability + AAD
         auth via DefaultAzureCredential). Wave 2 W2-3 extends consumption
         for index creation + document upsert (AiSearchRagIndexer per
         ADR-0021); Wave 3 W3-3 adds hybrid-retrieval queries via
         AiSearchRagRetriever. The 11.7.0 line is the GA major covering
         the v2024+ semantic-ranker + vector-field surface ADR-0021 locks. -->
    <PackageReference Include="Azure.Search.Documents" Version="11.7.0" />
    <!-- Azure.ResourceManager.CosmosDB drives ARM (control-plane) database/container
         CRUD for `CosmosBootstrapper.EnsureCreatedAsync`. Cosmos's data-plane RBAC
         genuinely does not include `sqlDatabases/write` (and there is no valid
         wildcard that covers it; PR #62 attempted `sqlDatabases/*` and Azure's
         deploy-time validation rejected it as "not a valid SQL data action").
         Schema bootstrap therefore uses ARM, which checks Azure RBAC — satisfied
         in dev by the developer's subscription Owner inheritance and in prod by
         the production identity holding `Cosmos DB Operator` at account scope.
         The data-plane SDK (Microsoft.Azure.Cosmos) below remains the canonical
         path for runtime item CRUD. -->
    <PackageReference Include="Azure.ResourceManager.CosmosDB" Version="1.4.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.59.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.7" />
    <PackageReference Include="Microsoft.Playwright" Version="1.59.0" />
    <!-- Microsoft.Azure.Cosmos uses Newtonsoft.Json internally for some
         connection-management paths. Our SystemTextJsonCosmosSerializer
         handles document (de)serialization, but the SDK's transitive check
         still requires Newtonsoft to be explicitly versioned. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PinballWizard.Core/PinballWizard.Core.csproj" />
    <ProjectReference Include="../PinballWizard.Application/PinballWizard.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests pin the deserialization contract for the internal DTO classes
         used by the Stern Playwright scrapers (LinkRaw, BulletinRaw).
         Playwright's EvaluateArgumentValueConverter calls
         Activator.CreateInstance(t) and assigns properties one by one;
         the contract test asserts a public parameterless ctor exists,
         that JsonPropertyName attributes match the JS-side keys, and that
         every property is settable. JsonPropertyName typos / accidental
         readonly-property changes / accidental positional-record reverts
         would otherwise only surface as "0 results" against the live site.
         See docs/decision-log.md DL-0002 for the full history. -->
    <InternalsVisibleTo Include="PinballWizard.Scraper.Tests" />
  </ItemGroup>

</Project>

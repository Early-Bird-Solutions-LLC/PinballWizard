{
  // AiFoundry:ProjectEndpoint gates IFoundryAgentFactory + IAiRouter
  // registration. Leave empty in local dev (Aspire emulator has no
  // Foundry to connect to). Set to the deployed Foundry project endpoint
  // URL when running against Azure.
  "AiFoundry": {
    "ProjectEndpoint": ""
  },

  // SilverballLabs:ApiKey is intentionally empty here — the real value is
  // injected from Key Vault (silverball-api-key secret) in deployed
  // environments and from the machine env var SilverballLabs__ApiKey in
  // local dev. Never commit a live key.
  "SilverballLabs": {
    "BaseUrl": "https://silverballlabs.com/api/v1",
    "ApiKey": "",
    "HttpTimeoutSeconds": 30
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>PinballWizard.Api</RootNamespace>
    <AssemblyName>PinballWizard.Api</AssemblyName>

    <!--
      Aspire publishes this as a Bicep-manifest resource alongside
      PinballWizard.Web. Disable locked-mode restore for the same
      reason as AppHost and Web — RID-specific asset resolution causes
      cross-platform lock-file failures in CI.
    -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <UserSecretsId>46916414-5dac-4793-a3d9-c82fbb451beb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Aspire Cosmos client integration. Lets the Api consume the
      ConnectionStrings:cosmos value the AppHost injects via
      pinwiz-api.WithReference(cosmos) — the local preview-emulator path.
      Mirrors the Cli and Web; in deployed environments Cosmos:AccountEndpoint
      drives the Managed-Identity path instead and this call is skipped.
    -->
    <PackageReference Include="Aspire.Microsoft.Azure.Cosmos" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PinballWizard.Application/PinballWizard.Application.csproj" />
    <ProjectReference Include="../PinballWizard.Infrastructure/PinballWizard.Infrastructure.csproj" />
    <ProjectReference Include="../PinballWizard.ServiceDefaults/PinballWizard.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PinballWizard.Application</RootNamespace>
    <AssemblyName>PinballWizard.Application</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Agents.AI is the core abstraction layer for the Microsoft
         Agent Framework (GA 1.0 shipped 2026-04-03 per ADR-0014). The
         AIAgent type used by IAiRouter lives here. The Foundry-specific
         provider (Microsoft.Agents.AI.Foundry, preview) is referenced
         from Infrastructure since it pulls in Azure.AI.Projects. -->
    <PackageReference Include="Microsoft.Agents.AI" />
    <!-- Azure.Core is referenced directly (not just transitively) so
         AiRouter.cs can catch Azure.RequestFailedException (the exception
         type Foundry / Azure.AI.Projects surfaces for 429 / 503 responses)
         and inspect its Status + GetRawResponse() header. Application
         already couples to Microsoft.Agents.AI; Azure.Core is the Azure
         SDK exception-abstraction layer that sits beneath Foundry. This
         is the only Azure SDK type used in Application — all other Azure
         integrations stay in Infrastructure per ADR-0006. -->
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Microsoft.Extensions.Hosting provides BackgroundService for
         WizardAgentWarmupHostedService (ADR-0026 § 11). Mirrors the
         pattern in CosmosClientWarmupHostedService (Infrastructure). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />

    <!-- Microsoft.ML.Tokenizers + Cl100kBase data package power the
         Phase 4 hybrid chunker (ADR-0019). cl100k_base is the BPE
         tokenizer used by `text-embedding-3-large` (ADR-0020) — pinning
         it here means chunk token counts match what the embedding model
         actually sees, so 512-token chunks don't quietly become 600+
         once they hit the embedder. The data package ships the BPE
         vocab as an embedded resource that
         `TiktokenTokenizer.CreateForEncoding("cl100k_base")` discovers
         via assembly load; both packages are required at runtime. -->
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" />

    <!-- Microsoft.ML.Tokenizers 2.0.0 transitively pulls
         Microsoft.Bcl.Memory 9.0.4, which has a high-severity vuln
         (GHSA-73j8-2gch-69rq). Direct-pin to 10.0.7 to override the
         transitive resolution and clear the NU1903 build break. The
         override is package-version-floor; remove it once
         Microsoft.ML.Tokenizers ships a release that depends on
         Bcl.Memory >= 10.x. -->
    <PackageReference Include="Microsoft.Bcl.Memory" />
  </ItemGroup>

  <ItemGroup>
    <!-- Per ADR-0018, sub-agent prompts live as embedded resources;
         IFoundryAgentFactory reads them at startup to construct each
         AIAgent via AIProjectClient.AsAIAgent. The Wizard / Valuation /
         Rules / Repair markdown files in Ai/Agents/ ship inside the
         compiled assembly so a single deploy carries the prompts. -->
    <EmbeddedResource Include="Ai\Agents\*.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PinballWizard.Core/PinballWizard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Internal members (e.g. SearchCorpusTool's TopK clamping
         constants) are exposed to the test project for behavior
         pinning. Mirrors the same line in PinballWizard.Infrastructure
         and PinballWizard.Core. -->
    <InternalsVisibleTo Include="PinballWizard.Scraper.Tests" />
  </ItemGroup>

</Project>

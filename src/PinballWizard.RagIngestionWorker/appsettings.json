{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.Azure.Cosmos": "Warning",
      "Azure.Search.Documents": "Warning"
    }
  },
  "Cosmos": {
    "ApplicationName": "pinwiz-rag-worker"
  },
  "Rag": {
    "Ingestion": {
      "AcceptedDocumentTypes": ["Manual", "ServiceBulletin"],
      "MaxFailuresPerDocument": 3,
      "ReconcileOnStartup": false
    },
    "ChangeFeed": {
      "SourceContainerName": "scraped_documents",
      "LeaseContainerName": "rag_leases",
      "ProcessorName": "rag-indexer",
      "StartFromBeginning": true
    }
  }
}

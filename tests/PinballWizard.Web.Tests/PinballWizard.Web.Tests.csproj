<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      Opt out of locked-mode restore — the Razor SDK introduces test-runner
      RID-specific assets similar to AppHost. Matches the AppHost opt-out
      rationale in PinballWizard.AppHost.csproj.
    -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.runner.json must be copied to output so the runner picks it up -->
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- bUnit + xUnit: Blazor component testing -->
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="MudBlazor" />
    <!--
      Override the vulnerable System.Security.Cryptography.Xml that bunit 2.x
      pulls transitively, which would otherwise fail restore with NU1903.
      The version and its advisory history live in Directory.Packages.props.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <!--
      Microsoft.AspNetCore.TestHost powers the in-process TestServer used
      by WizardAskStreamEndpointTests. Version matches ASP.NET Core .NET 10 GA.
    -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!--
      Playwright + axe-core for accessibility tests (Wave 3 PR-Q1b).
      Microsoft.Playwright is already versioned in Directory.Packages.props
      (shared with the scraper's browser automation use). Deque.AxeCore.Playwright
      wraps axe-core for Playwright page objects — see A11y/ test classes.
    -->
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Deque.AxeCore.Playwright" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!--
      PinballWizard.Api is referenced so the endpoint extension method
      (MapWizardStreamingEndpoints) is available for in-process TestServer
      tests without starting the real Api host.
    -->
    <ProjectReference Include="../../src/PinballWizard.Api/PinballWizard.Api.csproj" />
    <ProjectReference Include="../../src/PinballWizard.Web/PinballWizard.Web.csproj" />
  </ItemGroup>

</Project>

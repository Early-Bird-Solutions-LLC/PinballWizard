# ── Build stage ────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0-preview AS build
WORKDIR /src
COPY src/PinballWizard.Domain/PinballWizard.Domain.csproj src/PinballWizard.Domain/
COPY src/PinballWizard.Api/PinballWizard.Api.csproj src/PinballWizard.Api/
COPY src/PinballWizard.Web/PinballWizard.Web.csproj src/PinballWizard.Web/
RUN dotnet restore src/PinballWizard.Web/PinballWizard.Web.csproj
COPY src/ src/
RUN dotnet publish src/PinballWizard.Web -c Release -o /app --no-restore

# ── Runtime stage ──────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0-preview
WORKDIR /app
COPY --from=build /app .

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "PinballWizard.Web.dll"]

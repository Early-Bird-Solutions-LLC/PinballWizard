      "id": "ev-repair-0006",
      "question": "My Galactic Tank Force pinball won\u0027t boot \u2014 where do I begin troubleshooting?",
      "expected_sub_agent": "Repair",
      "predicted_sub_agent": "Repair",
      "expected_citation_set": [
